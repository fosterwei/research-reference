---
import '../styles/global.css';
import { SITE_NAME, OG_IMAGE, OG_IMAGE_ALT, ICON_V, GA_MEASUREMENT_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path beginning with "/", used for the self-referencing canonical. */
  path: string;
  /** Records with drafted content are indexable (see lib/site.ts isIndexable). */
  indexable?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** Append the site name to the title. Pages on the 60-character budget pass false when the base title is long. */
  siteSuffix?: boolean;
  /** Social card image, root-relative. The site-wide card is the default. */
  image?: string;
}
const { title, description, path, indexable = false, jsonld, siteSuffix = true, image = OG_IMAGE } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
// Social cards are fetched by crawlers that do not resolve relative URLs.
const ogImage = new URL(image, Astro.site).toString();
const pageTitle = title.includes(SITE_NAME) || !siteSuffix ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${ICON_V}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${ICON_V}`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`/icon-192.png?v=${ICON_V}`} />
    <link rel="icon" href={`/favicon.ico?v=${ICON_V}`} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICON_V}`} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#06336A" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {/* Google Analytics 4. `is:inline` keeps Astro from bundling these: the
        snippet has to stay exactly as Google ships it, and the loader must stay
        a separate async request rather than being inlined into a module. */}
    {GA_MEASUREMENT_ID && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}');`} />
      </Fragment>
    )}
    <slot name="head" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav aria-label="Primary">
          <a href="/compounds">Compounds</a>
          <a href="/stacks">Stacks</a>
          <a href="/compare">Comparisons</a>
          <a href="/tools">Tools</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-col foot-about">
          <p class="foot-brand">{SITE_NAME}</p>
          <p>A cited research reference for peptides. Every claim carries an evidence tier and links to the study it came from, quoted verbatim. Nothing here is medical, dosing or treatment advice, and nothing here is a recommendation to use any compound.</p>
        </div>
        <nav class="foot-col" aria-label="Browse">
          <p class="foot-head">Browse</p>
          <a href="/compounds">Compounds</a>
          <a href="/stacks">Stacks</a>
          <a href="/compare">Comparisons</a>
          <a href="/tools">Tools</a>
        </nav>
        <nav class="foot-col" aria-label="About this site">
          <p class="foot-head">About</p>
          <a href="/about">How pages are made</a>
          <a href="/about#tiers">Evidence tiers</a>
          <a href="/about#review">Publication and review</a>
          <a href="/privacy">Privacy</a>
          <a href="/contact">Contact and corrections</a>
          <a href="/about#not">What this site does not do</a>
        </nav>
      </div>
      <div class="wrap foot-meta">
        <span>Sources: Europe PMC and ChEMBL. Records carry their own revision dates.</span>
      </div>
    </footer>
  </body>
</html>

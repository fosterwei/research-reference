---
import '../styles/global.css';
import { SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path beginning with "/", used for the self-referencing canonical. */
  path: string;
  /** Only published records are indexable; everything else is noindex. */
  indexable?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** Append the site name to the title. Pages on the 60-character budget pass false when the base title is long. */
  siteSuffix?: boolean;
}
const { title, description, path, indexable = false, jsonld, siteSuffix = true } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const pageTitle = title.includes(SITE_NAME) || !siteSuffix ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <slot name="head" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav aria-label="Primary">
          <a href="/compounds">Compounds</a>
          <a href="/stacks">Stacks</a>
          <a href="/compare">Comparisons</a>
          <a href="/tools">Tools</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-col foot-about">
          <p class="foot-brand">{SITE_NAME}</p>
          <p>A cited research reference for peptides. Every claim carries an evidence tier and links to the study it came from, quoted verbatim. Nothing here is medical, dosing or treatment advice, and nothing here is a recommendation to use any compound.</p>
        </div>
        <nav class="foot-col" aria-label="Browse">
          <p class="foot-head">Browse</p>
          <a href="/compounds">Compounds</a>
          <a href="/stacks">Stacks</a>
          <a href="/compare">Comparisons</a>
          <a href="/tools">Tools</a>
        </nav>
        <nav class="foot-col" aria-label="About this site">
          <p class="foot-head">About</p>
          <a href="/about">How pages are made</a>
          <a href="/about#tiers">Evidence tiers</a>
          <a href="/about#review">Review status</a>
          <a href="/about#not">What this site does not do</a>
        </nav>
      </div>
      <div class="wrap foot-meta">
        <span>Sources: Europe PMC and ChEMBL. Records carry their own revision dates.</span>
        <span>Pages not yet signed by a named reviewer are excluded from search indexing.</span>
      </div>
    </footer>
  </body>
</html>

---
// v2 compound page, shared by the trial routes. When the design is approved,
// [slug].astro renders this for every compound and the trial routes go away.
//
// Composition is intent-driven (docs/design.md §10, docs/content-sop.md): if
// research/intents/<slug>.json exists, it orders the body blocks, supplies
// searcher-phrased headings and boundary sentences, adds FAQ items, and places
// explicit absence statements where demand exists and evidence does not. The
// spine (title, at-a-glance, status, what-it-is, assessment at the top; sources,
// reference card, related, changelog at the bottom) is fixed on every page so a
// reader and a reviewer always know where to find it. The map never changes a
// claim, a tier or a source.
import '../styles/compound-v2.css';
import '../styles/compound-v3.css';
import { records } from '../lib/collections';
import { guidesFor } from '../lib/guides';
import Base from './Base.astro';
import Tier from '../components/v2/Tier.astro';
import Toc from '../components/v2/Toc.astro';
import FactTiles from '../components/v2/FactTiles.astro';
import EvidenceAssessment from '../components/v2/EvidenceAssessment.astro';
import StatusBar from '../components/v2/StatusBar.astro';
import EvidenceTable from '../components/v2/EvidenceTable.astro';
import ClaimCards from '../components/v2/ClaimCards.astro';
import ClaimTable from '../components/v2/ClaimTable.astro';
import Faq from '../components/v2/Faq.astro';
import Sources from '../components/v2/Sources.astro';
import RefCard from '../components/v2/RefCard.astro';
import CompareTable from '../components/v2/CompareTable.astro';
import LandscapeTable from '../components/v2/LandscapeTable.astro';
import HumanTrials from '../components/v2/HumanTrials.astro';
import CombinationEvidence from '../components/v2/CombinationEvidence.astro';
import EditorialSection from '../components/v2/EditorialSection.astro';
import Calculators from '../components/Calculators.astro';
import { protocolFaq, quickStart } from '../lib/protocol';
import Protocol from '../components/v2/Protocol.astro';
import EvidenceMix from '../components/v2/EvidenceMix.astro';
import { qualifies as hasCalculator } from '../lib/calculators';
import { entityLinker } from '../lib/entities';
import { glossaryLinker } from '../lib/glossary';
import ReconstitutionMath from '../components/shared/ReconstitutionMath.astro';
import EquipmentInStudies from '../components/shared/EquipmentInStudies.astro';
import ReadingACoA from '../components/shared/ReadingACoA.astro';
import WeightCaveat from '../components/shared/WeightCaveat.astro';
import { rich, paragraphs, timeTag, esc } from '../lib/format';
import { SITE_NAME, isIndexable, title, description, lastmod, formatCount, imageObjects } from '../lib/site';
import { compound as regCompound, peers as regPeers, stacksContaining, comparisonsWith, className } from '../lib/registry';
import { loadIntent, headingFor, boundaryFor, orderBlocks, queriesFor } from '../lib/intents';
import { parseClaim } from '../lib/claims';
import { citer, findingsOnly } from '../lib/cite';
import { keywordHeading } from '../lib/headings';
import { digest } from '../lib/digest';
import { factCards } from '../lib/factcards';

// `trial` renders the page with the v3 proposals (styles/compound-v3.css,
// research/design-references/peptidedosingprotocols/design.md §5) on a
// noindex trial route, per docs/design.md §8. Off everywhere else.
interface Props { slug: string; trial?: boolean }
const { slug, trial = false } = Astro.props;
const all = await records('compounds');
const entry = all.find((e) => e.data.slug === slug);
if (!entry) throw new Error(`no record for ${slug}`);
const d = entry.data;
const proseCite = citer(((entry as any).data?.sources ?? []) as any[]);
const A = findingsOnly(d.attributes) as Record<string, any[]>;
const has = (f: string) => (A[f] ?? []).length > 0;
const reg = regCompound(d.slug);
const intent = loadIntent(d.slug);
const peerEntries = regPeers(d.slug).map((p) => all.find((e) => e.data.slug === p.slug)).filter((e): e is NonNullable<typeof e> => Boolean(e));
const inStacks = stacksContaining(d.slug);
const inComparisons = comparisonsWith(d.slug);
const pubs = d.evidence_summary?.publications ?? {};
const noEvidence = (pubs.total ?? 0) === 0;
const hasAnyEvidence = has('evidence_table');
const humanRows = (A.evidence_table ?? []).filter((r) => r.fields?.species === 'Humans' && !/method|in vitro|measured, not given/i.test(r.fields?.design ?? ''));
// Headline counts on the trial come from the record's full evidence table, as the glance tiles do.
const fullRows = ((d.attributes as any)?.evidence_table ?? []) as any[];
const fullHuman = fullRows.filter((r) => r.fields?.species === 'Humans' && !/method|in vitro|measured, not given/i.test(r.fields?.design ?? ''));
// Up to twelve human rows read as a list; beyond that the evidence table carries them.
const showHumanTrials = humanRows.length >= 1 && humanRows.length <= 12;
const path = `/compounds/${d.slug}${trial ? '-v3' : ''}`;
// Guides that hang under this record or declare they are about it (src/lib/guides.ts).
const guides = await guidesFor(path);
const guideKind = (g: any) => ({ index: 'Guide index', pillar: 'Topic guide', sub: 'In-depth guide' } as Record<string, string>)[g.data.role] ?? 'Guide';
const updated = lastmod(entry);
const seen = new Set<string>();
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title(entry), description: description(entry), dateModified: updated,
  datePublished: d.changelog[0]?.date, mainEntityOfPage: new URL(path, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: SITE_NAME, url: Astro.site?.toString(), logo: imageObjects(Astro.site).logo }, image: imageObjects(Astro.site).image,
  // "Who wrote this" and "who checked this" are separate signals, and the site
  // answered only the second. There is no human writer to name: the prose is
  // compiled from the record by the process the about page documents, so the
  // organisation is the honest answer, and a named person is used when a
  // record actually carries one.
  author: d.review.author
    ? { '@type': 'Person', name: d.review.author }
    : { '@type': 'Organization', name: SITE_NAME, url: Astro.site?.toString() },
  ...(d.review.reviewer ? { reviewedBy: { '@type': 'Person', name: d.review.reviewer, jobTitle: d.review.reviewer_credential, ...(d.review.reviewer_url ? { sameAs: d.review.reviewer_url } : {}) } } : {}),
};
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', path: '/' }, { name: 'Compounds', path: '/compounds' }, { name: d.preferred_name, path }].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, Astro.site).toString() })),
};
const dek = trial
  ? rich(`What ${formatCount(pubs.total)} indexed publications, ${fullHuman.length} human ${fullHuman.length === 1 ? 'study' : 'studies'} and ${formatCount(pubs.randomized_controlled_trials)} randomized trials state about ${d.preferred_name}, each claim cited.`, { bold: 2, seen })
  : rich(`What ${formatCount(pubs.total)} indexed publications and ${formatCount(pubs.randomized_controlled_trials)} randomized trials actually state about ${d.preferred_name.toLowerCase()}, sentence by sentence, each tied to its source and labeled by the kind of evidence it is.`, { bold: 2, seen });
const summaryParas = paragraphs(d.summary, 3).map((para) => rich(para, { bold: 2, seen }));
const peerLinks = peerEntries.map((e) => `<a href="/compounds/${e.data.slug}">${e.data.preferred_name}</a>`).join(', ');
const comparisonLinks = inComparisons.map((c) => `<a href="/compare/${c.slug}">${c.sides.map((s) => regCompound(s)?.name ?? s).join(' vs ')}</a>`).join(', ');
const brandAliases = d.aliases.filter((a) => /^[A-Z][a-z]/.test(a) && !/\d/.test(a) && !a.toLowerCase().startsWith(d.preferred_name.slice(0, 6).toLowerCase())).slice(0, 3);
const baseTitle = title(entry);

// Evidence fields in spec order: [record field, block id, default heading, human label for absence statements].
const evidence: Array<[string, string, string, string]> = [
  ['mechanism', 'mechanism', 'How it works', 'mechanism of action'],
  ['study_doses', 'doses', 'Doses reported in studies', 'doses'],
  ['escalation_schedules', 'escalation', 'Escalation schedules used in studies', 'dose-escalation schedules'],
  ['adverse_events', 'adverse', 'Adverse events and frequency', 'adverse events or their frequency'],
  ['study_durations', 'durations', 'Study durations', 'treatment durations'],
  ['routes_studied', 'routes', 'Routes studied', 'routes of administration'],
  ['weight_normalized_doses', 'weight', 'Weight-normalized doses, as published', 'weight-normalized doses'],
  ['reported_use', 'reported-use', 'What is commonly reported outside the literature', 'commonly reported use'],
  ['interactions', 'interactions', 'Reported interactions', 'interactions with other agents'],
  ['exclusion_criteria', 'exclusion', 'Exclusion criteria in studies', 'exclusion criteria'],
  ['biomarkers_monitored', 'biomarkers', 'Biomarkers measured in studies', 'biomarkers'],
  ['reported_timelines', 'timelines', 'Reported timelines', 'onset or duration of effect'],
  ['storage', 'storage', 'Storage and stability', 'storage or stability'],
];
const defaultLedes: Record<string, string> = {
  study_doses: `Each entry restates, in plain English, what one study's abstract reports, with the study's design, sample size and year above it and a numbered mark linking to the paper. Comparator doses in the same study are not attributed to ${d.preferred_name.toLowerCase()}.`,
  escalation_schedules: 'How trials stepped doses, reported as study design.',
  adverse_events: 'Events and their frequency as each study reported them, with the denominator where the abstract gives one.',
  study_durations: 'Treatment and follow-up periods as stated in each abstract.',
  routes_studied: 'Routes of administration named in each study.',
  interactions: 'Sentences in which the compound is studied alongside another agent. Read the study line: the word interaction can also be statistical.',
  exclusion_criteria: `Who was kept out of the trials of ${d.preferred_name}, and, where a medicine has an approved label, who the label says should not use it. Trials exclude people for safety and for clean results, so an exclusion shows where the evidence stops, not a verdict on any one person. Each line is restated from the trial report or label and cited.`,
  biomarkers_monitored: 'Laboratory and clinical measures the studies report tracking, including which hormones did and did not change.',
  weight_normalized_doses: 'Per-kilogram figures exactly as each study published them, for the species it studied.',
  storage: `How ${d.preferred_name} is stored, from the approved label where one exists and otherwise from stability studies. Each line is cited.`,
  reported_timelines: 'Onset, peak and duration figures as each study reported them.',
  mechanism: 'Written from general pharmacology and the development record, and marked as editorial synthesis; the measurements behind it are cited in the biomarker section.',
  reported_use: 'What circulates in user communities and clinic marketing, reported so a reader knows the figures and their origin. None of it has been tested in a trial, and none of it is a suggestion.',
};
// A boundary sentence from the intent map opens the lede when one exists (policy evidence-with-boundary).
const ledeFor = (f: string) => [boundaryFor(intent, f), defaultLedes[f]].filter(Boolean).join(' ');
// Trial: the answer first. One cited sentence that answers the section's
// question, before any method text; the method sentence moves behind a
// disclosure so the first line a reader meets is about the compound.
const SHOW = trial ? 5 : Infinity;
const answerFor = (f: string): string | undefined => {
  const first = (A[f] ?? []).find((c: any) => c.plain && c.source_ids?.length) as any;
  return first ? proseCite.sentence(first.plain, first.source_ids) : undefined;
};
// Where the drafter extracted a figure from every study (dose, route,
// duration, dose per kilogram), the section opens with one line that lists
// those figures by species and the per-study rows fold beneath it. Other
// sections open with their first cited sentence and show three rows.
const DIGEST = new Set(['study_doses', 'study_durations', 'routes_studied', 'weight_normalized_doses']);
const digestFor = (f: string) => (trial && DIGEST.has(f) ? digest(f, A[f] ?? [], (ids) => proseCite.marks(ids)) : undefined);
const leadFor = (f: string) => digestFor(f) ?? answerFor(f);
const showFor = (f: string) => (trial ? (digestFor(f) ? 0 : 3) : Infinity);
const evidenceAnswer = (() => {
  const rows = fullRows;
  const by = (re: RegExp) => rows.filter((r: any) => re.test(String(r.fields?.species ?? ''))).length;
  const animals = by(/rat|mice|mouse|dog|pig|rabbit|bee|fish|chick/i), cells = by(/cell|vitro|none/i);
  const h = fullHuman.length, rct = fullHuman.filter((r: any) => /random/i.test(r.fields?.design ?? '')).length;
  const people = h === 0 ? '0 in people' : `${h} in people (${rct === 0 ? 'none randomized' : `${rct} randomized`})`;
  return `<b>${rows.length} primary studies</b>: ${animals} in animals, ${cells} in cells, ${people}.${rct === 0 ? ' No randomized trial has tested it.' : ''}`;
})();

// Body blocks. Each renders only when it has content; an evidence field with no
// claims but with mapped demand renders as an explicit absence statement.
type Guide = { id: string; heading: string; lede?: string; html: string; pending?: boolean };
const guide: Guide[] = ((d as any).guide ?? []) as Guide[];
type Block = { id: string; kind: 'avoid' | 'bundle' | 'human' | 'table' | 'landscape' | 'claims' | 'absence' | 'method' | 'calculator' | 'protocol' | 'compare' | 'combination' | 'regulatory' | 'open' | 'faq' | 'guide'; field?: string; label: string; group: string; guide?: Guide; parts?: Block[] };
// Links the first mention of each other record in this page's own prose.
const linkEntities = entityLinker([d.slug], 10);
const linkTerms = glossaryLinker(4);
// Trial: lead-in paragraphs and lists in written sections render as labelled cards (src/lib/factcards.ts).
const guideHtml = (g: Guide) => { const h = proseCite.tokens(linkTerms(linkEntities(g.html))); return trial ? factCards(h) : h; };
// Trial: the record's quick answer takes the "what it is" slot at the top instead of the compiled summary, which restates the glance figures.
const quick = trial ? guide.find((g) => g.id === 'quick-answer') : undefined;
const blocks: Block[] = [];
// Written sections from the record's guide[]; the outline places them among the evidence blocks.
for (const g of guide) if (g !== quick) blocks.push({ id: g.id, kind: 'guide', label: g.heading, group: 'Evidence', guide: g });
if (showHumanTrials) blocks.push({ id: 'human-trials', kind: 'human', label: 'What happened in the human studies?', group: 'Evidence' });
if (hasAnyEvidence) blocks.push({ id: 'evidence', kind: 'table', field: 'evidence_table', label: headingFor(intent, 'evidence_table', 'What the evidence shows'), group: 'Evidence' });
else blocks.push({ id: 'landscape', kind: 'landscape', label: 'What is indexed', group: 'Evidence' });
for (const [f, id, label] of evidence) {
  if (has(f)) blocks.push({ id, kind: 'claims', field: f, label: headingFor(intent, f, label), group: 'Evidence' });
  else if (queriesFor(intent, f).some((q) => q.policy !== 'redirect')) blocks.push({ id, kind: 'absence', field: f, label: headingFor(intent, f, label), group: 'Evidence' });
  // "Who should avoid" is a fixed section: with no exclusion on record it says
  // so, and points to what the record does hold for this compound.
  else if (f === 'exclusion_criteria' && hasAnyEvidence) blocks.push({ id, kind: 'avoid', label: `Who should avoid ${d.preferred_name}? What the evidence can say`, group: 'Evidence' });
}
// Facts for the "who should avoid" fallback, all already on this page.
const HUMAN_TIERS = ['approved-label', 'human-clinical-trial', 'observational-human'];
const humanEvidence = HUMAN_TIERS.includes(d.evidence_tier);
// A cited plain statement first; otherwise the first sentence of the record's
// own editorial status line, shown as editorial and never with a mark.
const regCited = (A.regulatory_status ?? []).find((c: any) => c.plain && c.source_ids?.length);
const regEditorial = (A.regulatory_status ?? []).find((c: any) => c.drafting === 'editorial' && c.value);
const regLine = regCited
  ? { html: proseCite.sentence(regCited.plain, regCited.source_ids) }
  : regEditorial ? { html: `${esc(String(regEditorial.value).trim().split(/(?<=\.)\s+/)[0])} <span class="ed-note">(editorial; source pending)</span>` } : null;
const studiedIn = [...new Set((((d.attributes as any)?.protocol ?? []) as any[])
  .filter((c) => HUMAN_TIERS.includes(c.evidence_label) && c.fields?.phase !== 'note' && c.fields?.population)
  .map((c) => String(c.fields.population).replace(/\s*\(.*?\)\s*$/, '').replace(/,\s*n\s*=\s*\d+\s*$/i, ''))
  .filter((p) => !/not stated/i.test(p)))].slice(0, 3);
// The compound's own calculator, only where it has one: a record qualifies when
// it is finished and carries at least two distinct published dose figures, the
// same rule that decides whether /calculators/<slug> exists at all.
// The protocol layer renders only when the record carries a human regimen or a
// label; it is never filled from animal data (docs/content-contract.md).
const protocolClaims = ((A as any).protocol ?? []) as any[];
const protocolHere = protocolClaims.some((c) => ['approved-label', 'human-clinical-trial', 'observational-human'].includes(c.evidence_label));
if (protocolHere) blocks.push({ id: 'protocol', kind: 'protocol', label: headingFor(intent, 'protocol', `${d.preferred_name} dosing protocol`), group: 'Evidence' });
const calculatorHere = hasCalculator(entry);
if (calculatorHere) blocks.push({ id: 'calculator', kind: 'calculator', label: headingFor(intent, 'calculator', `${d.preferred_name} dosage calculator`), group: 'Evidence' });
if (hasAnyEvidence) blocks.push({ id: 'method', kind: 'method', label: 'Method notes', group: 'Method' });
if (peerEntries.length > 0) blocks.push({ id: 'compare', kind: 'compare', label: headingFor(intent, 'compare', 'Other compounds in its class'), group: 'Context' });
if (inStacks.length > 0) blocks.push({ id: 'combination', kind: 'combination', label: headingFor(intent, 'combination', 'Studied in combination'), group: 'Context' });
if (has('regulatory_status')) blocks.push({ id: 'regulatory', kind: 'regulatory', field: 'regulatory_status', label: headingFor(intent, 'regulatory_status', 'Regulatory status'), group: 'Context' });
if (d.open_questions.length > 0) blocks.push({ id: 'open', kind: 'open', label: 'Open questions and limitations', group: 'Context' });

// FAQ: intent-mapped questions first (in the searcher's words, answered from a
// claim or from our own prose), then the record's derived questions.
const cite = citer(d.sources);
const intentFaq = queriesFor(intent, 'faq').map((q) => {
  const claim = q.answer_from ? (A[q.answer_from] ?? [])[0] : undefined;
  if (claim) {
    if ((claim as any).plain) return { question: q.heading ?? q.query, answer: cite.sentence((claim as any).plain, claim.source_ids) };
    const p = parseClaim(claim);
    const src = claim.source_ids?.[0];
    const body = p.quote ? `${esc(p.design)}${p.year ? `, ${p.year}` : ''}: <q>${esc(p.quote)}</q>` : esc(claim.value);
    return { question: q.heading ?? q.query, answer: `${body}${src ? cite.marks([src]) : ''}` };
  }
  return q.answer ? { question: q.heading ?? q.query, answer: rich(q.answer, { bold: 2, seen }) } : null;
}).filter((x): x is { question: string; answer: string } => Boolean(x));
// Redirect queries are the next questions readers ask; they become contextual links (design.md §10.3).
const nextQuestions = (intent?.queries ?? [])
  .filter((q) => q.policy === 'redirect' && q.target)
  .sort((x, y) => ((y.volume?.clickstream ?? y.volume?.google_ads ?? 0) - (x.volume?.clickstream ?? x.volume?.google_ads ?? 0)))
  .map((q) => ({ label: q.heading && !/^(How it compares|Studied in combination)$/.test(q.heading) ? q.heading : q.query.replace(/\b\w/, (c) => c.toUpperCase()), href: q.target! }))
  .filter((q, i, arr) => arr.findIndex((x) => x.href === q.href) === i);
// Dosing questions in the words searches use, answered from the reviewed
// protocol claims (src/lib/protocol.ts); skipped where the intent map or the
// record already asks the same question.
const citeIds = (ids: string[]) => cite.marks(ids);
const baseFaq = [...intentFaq, ...d.faq.map((f) => ({ question: f.question, answer: rich(f.answer, { bold: 2, seen }) }))];
const askedAlready = new Set(baseFaq.map((f) => f.question.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim()));
// The first three quick-start facts, repeated under "At a glance" so a reader
// searching for the dose sees it without scrolling to the dosing guide.
const dosingGlance = protocolHere ? quickStart(protocolClaims).slice(0, 3) : [];
const dosingFaq = protocolHere ? protocolFaq(d.preferred_name, protocolClaims, citeIds).filter((f) => !askedAlready.has(f.question.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim())) : [];
const faqItems = [...dosingFaq, ...baseFaq];
if (faqItems.length > 0) blocks.push({ id: 'faq', kind: 'faq', label: 'Questions people ask', group: 'Context' });
const faqSchema = faqItems.length > 0 ? [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'") } })),
}] : [];

// The trial drops the compound name from H2s: it stays in the title, dek and
// first paragraph (docs/design.md §1 rejected the prefix on every heading).
const kwh = (t: string) => (trial ? t : keywordHeading(d.preferred_name, t));
// Three or more claims that carry a study line read better as a table.
const tabular = (claims: any[] = []) => claims.length >= 3 && claims.filter((c) => parseClaim(c).design).length >= Math.ceil(claims.length * 0.6);
for (const b of blocks) {
  b.label = kwh(b.label);
  if (b.guide) b.guide = { ...b.guide, heading: kwh(b.guide.heading) };
}
// Thin sections: a minor evidence field with a single finding does not earn
// its own H2. When two or more of them occur they are gathered into one section
// at the position of the first, each keeping its keyword heading (as an H3) and
// its anchor, so links to #timelines or #interactions still land.
const BUNDLED = new Set(['escalation_schedules', 'study_durations', 'routes_studied', 'weight_normalized_doses', 'interactions', 'reported_timelines']);
const thin = (b: Block) => b.kind === 'claims' && BUNDLED.has(b.field!) && (A[b.field!] ?? []).length === 1;
const ordered = orderBlocks(intent, blocks);
const thinParts = ordered.filter(thin);
const body: Block[] = thinParts.length < 2 ? ordered : ordered.flatMap((b) => {
  if (!thin(b)) return [b];
  if (b !== thinParts[0]) return [];
  const words: Record<string, string> = { escalation_schedules: 'titration', study_durations: 'cycle length', routes_studied: 'routes', weight_normalized_doses: 'dose per kg', interactions: 'interactions', biomarkers_monitored: 'blood tests', reported_timelines: 'timeline' };
  const topics = thinParts.map((p) => words[p.field!]);
  const list = topics.length > 1 ? `${topics.slice(0, -1).join(', ')} and ${topics[topics.length - 1]}` : topics[0];
  return [{ id: 'more-findings', kind: 'bundle', label: `More ${d.preferred_name} study details: ${list}`, group: 'Evidence', parts: thinParts } as Block];
});
const secs = [
  { id: 'glance', label: kwh('At a glance'), group: '' },
  quick ? { id: quick.id, label: kwh(quick.heading), group: '' } : { id: 'what', label: kwh(headingFor(intent, 'what', 'What it is')), group: '' },
  { id: 'assessment', label: kwh('What the evidence level means'), group: 'Evidence' },
  ...body.filter((b) => b.kind !== 'method').map((b) => ({ id: b.id, label: b.label, group: b.group })),
  ...(hasAnyEvidence ? [
    { id: 'method-recon', label: 'Reconstitution mathematics', group: 'Method' },
    { id: 'method-equipment', label: 'Equipment described in studies', group: 'Method' },
    { id: 'method-coa', label: 'Reading a certificate of analysis', group: 'Method' },
  ] : []),
  { id: 'sources', label: `Sources (${d.sources.length})`, group: 'Reference' },
  { id: 'card', label: 'Reference card', group: 'Reference' },
  ...(guides.length + inStacks.length + inComparisons.length + peerEntries.length > 0 ? [{ id: 'related', label: 'Related records', group: 'Reference' }] : []),
  ...(d.changelog.length > 0 ? [{ id: 'changelog', label: 'What changed', group: 'Reference' }] : []),
];
// Keep TOC order faithful to render order: method entries sit where the band renders.
const tocBody = body.flatMap((b) => b.kind === 'method'
  ? [{ id: 'method-recon', label: 'Reconstitution mathematics', group: 'Method' }, { id: 'method-equipment', label: 'Equipment described in studies', group: 'Method' }, { id: 'method-coa', label: 'Reading a certificate of analysis', group: 'Method' }]
  : [{ id: b.id, label: b.label, group: b.group }]);
const toc = [secs[0], secs[1], secs[2], ...tocBody, ...secs.filter((s) => ['sources', 'card', 'related', 'changelog'].includes(s.id))];
---
<Base title={baseTitle} description={description(entry)} path={path} indexable={!trial && isIndexable(entry)} jsonld={[jsonld, breadcrumbs, ...faqSchema]} siteSuffix={`${baseTitle} | ${SITE_NAME}`.length <= 60}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Source+Sans+3:wght@400;600&display=swap" />
  </Fragment>
  <article class:list={['v2', { v3: trial }]}>
    <div class="title">
      <div class="crumbs"><a class="eyebrow" href="/compounds">Compounds</a>{reg && <><span class="dot">·</span><a class="eyebrow" href={`/compounds#${reg.class}`}>{className(reg.class)}</a><span class="dot">·</span><span class="eyebrow">{reg.target}</span></>}</div>
      <h1>{intent?.h1 ?? d.preferred_name}</h1>
      <p class="dek" set:html={dek} />
      <div class="pills">
        <span class="pill"><Tier tier={d.evidence_tier} /></span>
        {d.review?.reviewer && <span class="pill">Reviewed <Fragment set:html={timeTag(d.review.reviewed_at)} /></span>}
        <span class="pill">{d.sources.length} sources</span>
        {updated && <span class="pill">Updated <Fragment set:html={timeTag(updated)} /></span>}
        {brandAliases.length > 0 && <span class="pill dashed">Also: {brandAliases.join(', ')}</span>}
      </div>
      {trial && d.review?.reviewer && (
        <p class="byline">Reviewed by <b>{d.review.reviewer_url ? <a href={d.review.reviewer_url} rel="nofollow noopener">{d.review.reviewer}</a> : d.review.reviewer}</b>, {d.review.reviewer_credential}<span class="sep">·</span>Last reviewed <Fragment set:html={timeTag(d.review.reviewed_at)} />{updated && updated !== d.review.reviewed_at && <><span class="sep">·</span>Updated <Fragment set:html={timeTag(updated)} /></>}<span class="sep">·</span><a href="#changelog">What changed</a></p>
      )}
      {trial && hasAnyEvidence && <EvidenceMix rows={fullRows} pubs={pubs} name={d.preferred_name} />}
    {trial && (
      <aside class="glance-panel" aria-label="At a glance">
        <p class="eyebrow">At a glance</p>
        <FactTiles record={d} reg={reg} />
        {dosingGlance.length > 0 && (
          <div class="dosing-glance">
            <h3>Dosing at a glance</h3>
            <dl class="facts">{dosingGlance.map((f) => <div class="fact"><dt class="k">{f.k}</dt><dd class="v sm">{f.v}</dd>{f.s && <dd class="s">{f.s}</dd>}</div>)}</dl>
            <p class="more"><a href="#protocol">Full dosing guide</a></p>
          </div>
        )}
      </aside>
    )}
    </div>

    <div class="layout">
      <aside><Toc items={toc} /></aside>
      <div class="content">
        <section id="glance"><h2>{kwh('At a glance')}</h2><FactTiles record={d} reg={reg} />
          {dosingGlance.length > 0 && (
            <div class="dosing-glance">
              <h3>Dosing at a glance</h3>
              <dl class="facts">{dosingGlance.map((f) => <div class="fact"><dt class="k">{f.k}</dt><dd class="v sm">{f.v}</dd>{f.s && <dd class="s">{f.s}</dd>}</div>)}</dl>
              <p class="more"><a href="#protocol">{dosingGlance[0].k === 'Starting dose' ? 'Full dosing guide: schedule, trials behind each step, and notes' : 'Doses given in human studies, with their sources'}</a></p>
            </div>
          )}
        </section>
        <StatusBar review={d.review} status={d.status} sources={d.sources.length} updated={updated} />
        {intent?.decline_notice && <p class="lede">{intent.decline_notice}</p>}
        {quick
          ? <EditorialSection id={quick.id} heading={kwh(quick.heading)} lede={quick.lede} html={guideHtml(quick)} pending={quick.pending} addedAfterReview={(quick as any).added_after_review} />
          : <section id="what"><h2>{kwh(headingFor(intent, 'what', 'What it is'))}</h2>{summaryParas.map((html) => <p class="prose-lg" set:html={html} />)}</section>}
        <EvidenceAssessment record={d} heading={kwh('What the evidence level means')} compact={trial} />
        {nextQuestions.length > 0 && (
          <nav class="next-q" aria-label="Related questions"><span class="eyebrow">People also look for</span>
            <ul>{nextQuestions.map((q) => <li><a href={q.href}>{q.label}</a></li>)}</ul>
          </nav>
        )}
        {noEvidence && <div class="status"><div><strong>No indexed study names this compound</strong> in its title or abstract. Everything that circulates about it is community-reported, and this page does not restate it as fact. The sections that depend on published evidence are omitted rather than filled.</div></div>}

        {body.map((b) => {
          switch (b.kind) {
            case 'guide': return <EditorialSection id={b.guide!.id} heading={b.guide!.heading} lede={b.guide!.lede} html={guideHtml(b.guide!)} pending={b.guide!.pending} addedAfterReview={(b.guide as any).added_after_review} />;
            case 'human': return <HumanTrials rows={A.evidence_table} name={d.preferred_name} sources={d.sources} max={12} heading={kwh('What happened in the human studies?')} />;
            case 'landscape': return <section id="landscape"><div><h2>{b.label}</h2><p class="lede">Counts from Europe PMC. Zeros are measured, not missing.</p></div><LandscapeTable record={d} /></section>;
            case 'table': return (
              <section id="evidence">
                <div><h2>{b.label}</h2>{trial && <p class="answer" set:html={evidenceAnswer} />}<p class="lede">{[boundaryFor(intent, 'evidence_table'), ...(trial ? [] : ['One row per primary study in this record\'s ledger. Fields are read from each paper\'s indexing and abstract. "Analytical method" marks papers about detecting or measuring the compound rather than about its effects.'])].filter(Boolean).join(' ')}</p>{trial && <details class="about"><summary>About this table</summary><p>One row per primary study in this record's ledger. Fields are read from each paper's indexing and abstract. "Analytical method" marks papers about detecting or measuring the compound rather than about its effects.</p></details>}</div>
                <EvidenceTable rows={A.evidence_table} sources={d.sources} visible={SHOW} />
              </section>
            );
            case 'protocol': return (
              <section id="protocol"><div><h2>{b.label}</h2>{trial && dosingGlance.length > 0 && <p class="answer">{dosingGlance.map((f, i) => <>{i > 0 && ' · '}<b>{f.k}:</b> {f.v}</>)}</p>}<p class="lede">{boundaryFor(intent, 'protocol') ?? `How ${d.preferred_name} has been dosed: on an approved label where one exists, in the trials that gave it, and as a practical schedule read from those. Each block says where its figures come from.`}</p></div>
                <Protocol claims={protocolClaims} sources={d.sources} name={d.preferred_name} review={d.review ?? {}} />
              </section>
            );
            case 'calculator': return (
              <section id="calculator"><div><h2>{b.label}</h2><p class="lede">Enter a vial and a dose and it returns the concentration, the volume and the units on your syringe. It converts the numbers you give it and suggests none. The doses studies of {d.preferred_name} actually used, with a units chart per vial size, are on the <a href={`/calculators/${d.slug}`}>full {d.preferred_name} calculator page</a>.</p></div>
                <Calculators slug="reconstitution-calculator" id="calculator-tool" heading="Work out concentration and what to draw" headingLevel={3} big={trial} />
              </section>
            );
            case 'avoid': {
              const ae = (A.adverse_events ?? []).length;
              return (
                <section id={b.id}><div><h2>{b.label}</h2></div>
                  <div class="status"><div><strong>{humanEvidence
                    ? `The human studies of ${d.preferred_name} on this record do not state their exclusion criteria in a source this page can cite, and no approved label is on record, so there is no evidence-based list of who should avoid it.`
                    : `${d.preferred_name} has no human trial on this record, so no study has defined who should avoid it. What is known about its safety comes from animal or cell studies.`}</strong> That is an absence of evidence, not a sign that it suits everyone.</div></div>
                  <ul class="prose avoid-facts">
                    {regLine && <li><b>Regulatory status.</b> <Fragment set:html={regLine.html} />{has('regulatory_status') && <> More under <a href="#regulatory">regulatory status</a>.</>}</li>}
                    <li><b>Side effects.</b> {ae > 0 ? <>The record holds {ae} side-effect finding{ae === 1 ? '' : 's'}, each cited, under <a href="#adverse">{d.preferred_name} side effects</a>.</> : <>No side-effect finding is on record. That means none was reported in a source this page can cite, not that none occurs.</>}</li>
                    {studiedIn.length > 0 && <li><b>Who has been studied.</b> Human studies on record enrolled: {studiedIn.map((p, i) => <>{i > 0 ? '; ' : ''}{p.charAt(0).toLowerCase() + p.slice(1)}</>)}. Evidence does not extend beyond the people studied.</li>}
                    <li><b>Why trials exclude people.</b> See <a href="/glossary#exclusion-criteria">exclusion criteria</a> in the glossary.</li>
                  </ul>
                </section>
              );
            }
            case 'bundle': return (
              <section id="more-findings"><div><h2>{b.label}</h2><p class="lede">Topics where the record holds a single finding so far, gathered here rather than given a section each. Every finding is restated in plain English and cited.</p></div>
                {b.parts!.map((p) => <div class="bundle-part" id={p.id}><h3>{p.label}</h3><ClaimCards claims={A[p.field!]} sources={d.sources} visible={trial ? 3 : Infinity} />{p.field === 'weight_normalized_doses' && <WeightCaveat />}</div>)}
              </section>
            );
            case 'claims': return (
              <section id={b.id}><div><h2>{b.label}</h2>{trial && leadFor(b.field!) && <p class="answer" set:html={leadFor(b.field!)} />}{trial ? <>{boundaryFor(intent, b.field!) && <p class="lede">{boundaryFor(intent, b.field!)}</p>}{defaultLedes[b.field!] && <details class="about"><summary>About this section</summary><p>{defaultLedes[b.field!]}{b.field === 'study_durations' && <> How this compares with other compounds is on the <a href="/cycles">peptide cycle length</a> page.</>}</p></details>}</> : <p class="lede">{ledeFor(b.field!)}{b.field === 'study_durations' && <> How this compares with other compounds is on the <a href="/cycles">peptide cycle length</a> page.</>}</p>}</div>{tabular(A[b.field!]) ? <ClaimTable claims={A[b.field!]} sources={d.sources} caption={`${b.label}: one row per study, each finding cited.`} visible={showFor(b.field!)} /> : <ClaimCards claims={A[b.field!]} sources={d.sources} visible={showFor(b.field!)} />}{b.field === 'weight_normalized_doses' && <WeightCaveat />}</section>
            );
            case 'absence': {
              const human = evidence.find(([f]) => f === b.field)?.[3] ?? b.field;
              return (
                <section id={b.id}><div><h2>{b.label}</h2></div>
                  <div class="status"><div><strong>No study in this record's ledger reports {human} for {d.preferred_name.toLowerCase()}.</strong> {d.sources.length} indexed sources were searched. {boundaryFor(intent, b.field!) ?? 'An absence in the literature is not evidence of safety or effect; it means the question has not been studied in a paper this record can cite.'}</div></div>
                </section>
              );
            }
            case 'method': return (
              <div class="method">
                <div class="grid">
                  {trial ? (
                    <>
                      <div><span class="eyebrow">Method note · shared across compounds</span><details class="mnote"><summary><h3 id="method-recon">Reconstitution mathematics</h3></summary><ReconstitutionMath /></details></div>
                      <div><span class="eyebrow">Method note · shared across compounds</span><details class="mnote"><summary><h3 id="method-coa">Reading a certificate of analysis</h3></summary><ReadingACoA /></details></div>
                      <div style="grid-column: 1 / -1"><span class="eyebrow">Method note · shared across compounds</span><details class="mnote"><summary><h3 id="method-equipment">Equipment described in studies</h3></summary><EquipmentInStudies /></details></div>
                    </>
                  ) : (
                    <>
                      <div><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-recon">Reconstitution mathematics</h3><ReconstitutionMath /></div>
                      <div><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-coa">Reading a certificate of analysis</h3><ReadingACoA /></div>
                      <div style="grid-column: 1 / -1"><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-equipment">Equipment described in studies</h3><EquipmentInStudies /></div>
                    </>
                  )}
                </div>
              </div>
            );
            case 'compare': return (
              <section id="compare"><div><h2>{b.label}</h2><p class="lede">{boundaryFor(intent, 'compare') ? boundaryFor(intent, 'compare') + ' ' : ''}Same class in the registry: <Fragment set:html={peerLinks} />. Each row shows what that compound's own record states; nothing is inferred across rows.{inComparisons.length > 0 && <> Head-to-head evidence, where any exists, is on the comparison page{inComparisons.length > 1 ? 's' : ''}: <Fragment set:html={comparisonLinks} />.</>}</p></div><CompareTable self={entry} peers={peerEntries} cls={reg ? className(reg.class) : 'same'} /></section>
            );
            case 'combination': return <CombinationEvidence slug={d.slug} name={d.preferred_name} heading={b.label} boundary={boundaryFor(intent, 'combination')} />;
            case 'regulatory': return <section id="regulatory"><div><h2>{b.label}</h2>{trial && answerFor('regulatory_status') && <p class="answer" set:html={answerFor('regulatory_status')} />}<p class="lede">{[boundaryFor(intent, 'regulatory_status'), 'Registry facts only. Jurisdiction-level status, compounding categories and sport prohibitions need their own cited documents before they appear here.'].filter(Boolean).join(' ')}</p></div><ClaimCards claims={A.regulatory_status} sources={d.sources} visible={showFor('regulatory_status')} /></section>;
            case 'open': return <section id="open"><div><h2>{b.label}</h2><p class="lede">What is genuinely unknown, stated plainly. A missing field is not evidence that the outcome is safe, effective, or established.</p></div><ul class="list">{d.open_questions.map((q) => <li>{q}</li>)}</ul>{d.evidence_assessment?.limitations?.length > 0 && <><h3>Study limitations</h3><ul class="list">{d.evidence_assessment.limitations.map((q: string) => <li>{q}</li>)}</ul></>}</section>;
            case 'faq': return <section id="faq"><h2>{b.label}</h2><Faq items={faqItems} html openFirst={!trial} /></section>;
          }
        })}

        {d.sources.length > 0 && <section id="sources"><div><h2>Sources</h2><p class="lede">Full citations, numbered. The bracketed numbers after each statement on this page link to these.</p></div><Sources sources={d.sources} /></section>}
        <section id="card"><h2>Reference card</h2><RefCard record={d} reg={reg} path={path} /></section>
        {(guides.length > 0 || inStacks.length > 0 || inComparisons.length > 0 || peerEntries.length > 0 || calculatorHere) && (
          <section id="related"><h2>Related records</h2><ul class="cards">
          {guides.map((g) => <li><a href={`/blog/${g.data.slug}`}>{g.data.title}</a><div class="sub">{guideKind(g)}</div></li>)}
            {calculatorHere && <li><a href={`/calculators/${d.slug}`}>{d.preferred_name} dosage calculator</a><div class="sub">Units, mg and reconstitution, with the doses studies used</div></li>}
            {peerEntries.map((p) => <li><a href={`/compounds/${p.data.slug}`}>{p.data.preferred_name}</a><div class="sub">Peer compound</div></li>)}
            {inStacks.map((s) => <li><a href={`/stacks/${s.slug}`}>{s.name}</a><div class="sub">Stack · wave {s.pilot_wave}</div></li>)}
            {inComparisons.map((c) => <li><a href={`/compare/${c.slug}`}>{c.sides.join(' vs ')}</a><div class="sub">Comparison · wave {c.pilot_wave}</div></li>)}
          </ul>
          <p class="lede">Browse <a href="/compounds">all compounds</a>, <a href="/stacks">stacks</a>, <a href="/compare">comparisons</a> and <a href="/tools">tools</a>.</p></section>
        )}
        {d.changelog.length > 0 && <section id="changelog"><div><h2>Last reviewed and what changed</h2><p class="lede">Newest first. These are the record's own revision dates, and the same dates feed the sitemap.</p></div>{trial && d.changelog.length > 3
          ? <><ol class="changelog" reversed start={d.changelog.length}>{[...d.changelog].reverse().slice(0, 3).map((c) => <li><Fragment set:html={timeTag(c.date, c.date)} /> · {c.change}</li>)}</ol><details class="more-rows"><summary>Show all <b>{d.changelog.length}</b> changes</summary><ol class="changelog" reversed start={d.changelog.length - 3}>{[...d.changelog].reverse().slice(3).map((c) => <li><Fragment set:html={timeTag(c.date, c.date)} /> · {c.change}</li>)}</ol></details></>
          : <ol class="changelog" reversed>{[...d.changelog].reverse().map((c) => <li><Fragment set:html={timeTag(c.date, c.date)} /> · {c.change}</li>)}</ol>}</section>}
      </div>
    </div>
  </article>
</Base>

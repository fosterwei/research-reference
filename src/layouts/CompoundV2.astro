---
// v2 compound page, shared by the trial routes. When the design is approved,
// [slug].astro renders this for every compound and the trial routes go away.
//
// Composition is intent-driven (docs/design.md §10, docs/content-sop.md): if
// research/intents/<slug>.json exists, it orders the body blocks, supplies
// searcher-phrased headings and boundary sentences, adds FAQ items, and places
// explicit absence statements where demand exists and evidence does not. The
// spine (title, at-a-glance, status, what-it-is, assessment at the top; sources,
// reference card, related, changelog at the bottom) is fixed on every page so a
// reader and a reviewer always know where to find it. The map never changes a
// claim, a tier or a source.
import '../styles/compound-v2.css';
import { records } from '../lib/collections';
import Base from './Base.astro';
import Tier from '../components/v2/Tier.astro';
import Toc from '../components/v2/Toc.astro';
import FactTiles from '../components/v2/FactTiles.astro';
import EvidenceAssessment from '../components/v2/EvidenceAssessment.astro';
import StatusBar from '../components/v2/StatusBar.astro';
import EvidenceTable from '../components/v2/EvidenceTable.astro';
import ClaimCards from '../components/v2/ClaimCards.astro';
import Faq from '../components/v2/Faq.astro';
import Sources from '../components/v2/Sources.astro';
import RefCard from '../components/v2/RefCard.astro';
import CompareTable from '../components/v2/CompareTable.astro';
import LandscapeTable from '../components/v2/LandscapeTable.astro';
import HumanTrials from '../components/v2/HumanTrials.astro';
import CombinationEvidence from '../components/v2/CombinationEvidence.astro';
import EditorialSection from '../components/v2/EditorialSection.astro';
import ReconstitutionMath from '../components/shared/ReconstitutionMath.astro';
import EquipmentInStudies from '../components/shared/EquipmentInStudies.astro';
import ReadingACoA from '../components/shared/ReadingACoA.astro';
import WeightCaveat from '../components/shared/WeightCaveat.astro';
import { rich, paragraphs, timeTag, esc } from '../lib/format';
import { isIndexable, title, description, lastmod, formatCount } from '../lib/site';
import { compound as regCompound, peers as regPeers, stacksContaining, comparisonsWith, className } from '../lib/registry';
import { loadIntent, headingFor, boundaryFor, orderBlocks, queriesFor } from '../lib/intents';
import { parseClaim } from '../lib/claims';

interface Props { slug: string }
const { slug } = Astro.props;
const all = await records('compounds');
const entry = all.find((e) => e.data.slug === slug);
if (!entry) throw new Error(`no record for ${slug}`);
const d = entry.data;
const A = d.attributes as Record<string, any[]>;
const has = (f: string) => (A[f] ?? []).length > 0;
const reg = regCompound(d.slug);
const intent = loadIntent(d.slug);
const peerEntries = regPeers(d.slug).map((p) => all.find((e) => e.data.slug === p.slug)).filter((e): e is NonNullable<typeof e> => Boolean(e));
const inStacks = stacksContaining(d.slug);
const inComparisons = comparisonsWith(d.slug);
const pubs = d.evidence_summary?.publications ?? {};
const noEvidence = (pubs.total ?? 0) === 0;
const hasAnyEvidence = has('evidence_table');
const humanRows = (A.evidence_table ?? []).filter((r) => r.fields?.species === 'Humans' && !/method|in vitro/i.test(r.fields?.design ?? ''));
const showHumanTrials = humanRows.length >= 1 && humanRows.length <= 6;
const path = `/compounds/${d.slug}`;
const updated = lastmod(entry);
const seen = new Set<string>();
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title(entry), description: description(entry), dateModified: updated,
  datePublished: d.changelog[0]?.date, mainEntityOfPage: new URL(path, Astro.site).toString(),
  publisher: { '@type': 'Organization', name: 'Peptide Research Reference', url: Astro.site?.toString() },
  ...(d.review.author ? { author: { '@type': 'Person', name: d.review.author } } : {}),
  ...(d.review.reviewer ? { reviewedBy: { '@type': 'Person', name: d.review.reviewer, jobTitle: d.review.reviewer_credential } } : {}),
};
const dek = rich(`What ${formatCount(pubs.total)} indexed publications and ${formatCount(pubs.randomized_controlled_trials)} randomized trials actually state about ${d.preferred_name.toLowerCase()}, sentence by sentence, each tied to its source and labeled by the kind of evidence it is.`, { bold: 2, seen });
const summaryParas = paragraphs(d.summary, 3).map((para) => rich(para, { bold: 2, seen }));
const peerLinks = peerEntries.map((e) => `<a href="/compounds/${e.data.slug}">${e.data.preferred_name}</a>`).join(', ');
const comparisonLinks = inComparisons.map((c) => `<a href="/compare/${c.slug}">${c.sides.map((s) => regCompound(s)?.name ?? s).join(' vs ')}</a>`).join(', ');
const brandAliases = d.aliases.filter((a) => /^[A-Z][a-z]/.test(a) && !/\d/.test(a) && !a.toLowerCase().startsWith(d.preferred_name.slice(0, 6).toLowerCase())).slice(0, 3);
const baseTitle = title(entry);

// Evidence fields in spec order: [record field, block id, default heading, human label for absence statements].
const evidence: Array<[string, string, string, string]> = [
  ['mechanism', 'mechanism', 'How it works', 'mechanism of action'],
  ['study_doses', 'doses', 'Doses reported in studies', 'doses'],
  ['escalation_schedules', 'escalation', 'Escalation schedules used in studies', 'dose-escalation schedules'],
  ['adverse_events', 'adverse', 'Adverse events and frequency', 'adverse events or their frequency'],
  ['study_durations', 'durations', 'Study durations', 'treatment durations'],
  ['routes_studied', 'routes', 'Routes studied', 'routes of administration'],
  ['weight_normalized_doses', 'weight', 'Weight-normalized doses, as published', 'weight-normalized doses'],
  ['reported_use', 'reported-use', 'What is commonly reported outside the literature', 'commonly reported use'],
  ['interactions', 'interactions', 'Reported interactions', 'interactions with other agents'],
  ['exclusion_criteria', 'exclusion', 'Exclusion criteria in studies', 'exclusion criteria'],
  ['biomarkers_monitored', 'biomarkers', 'Biomarkers measured in studies', 'biomarkers'],
  ['reported_timelines', 'timelines', 'Reported timelines', 'onset or duration of effect'],
  ['storage', 'storage', 'Storage and stability', 'storage or stability'],
];
const defaultLedes: Record<string, string> = {
  study_doses: `Each entry is a sentence quoted from the study's abstract, with the study's design, sample size and year in front of it. Comparator doses in the same sentence are not attributed to ${d.preferred_name.toLowerCase()}.`,
  escalation_schedules: 'How trials stepped doses, reported as study design.',
  adverse_events: 'Events and their frequency as each study reported them, with the denominator where the abstract gives one.',
  study_durations: 'Treatment and follow-up periods as stated in each abstract.',
  routes_studied: 'Routes of administration named in each study.',
  interactions: 'Sentences in which the compound is studied alongside another agent. Read the quotation: the word interaction can also be statistical.',
  exclusion_criteria: 'Who each trial excluded, as stated in the abstract.',
  biomarkers_monitored: 'Laboratory and clinical measures the studies report tracking, including which hormones did and did not change.',
  weight_normalized_doses: 'Per-kilogram figures exactly as each study published them, for the species it studied.',
  storage: 'Stability and storage conditions as reported.',
  reported_timelines: 'Onset, peak and duration figures as each study reported them.',
  mechanism: 'Written from general pharmacology and the development record, and marked as editorial synthesis; the measurements behind it are quoted in the biomarker section.',
  reported_use: 'What circulates in user communities and clinic marketing, reported so a reader knows the figures and their origin. None of it has been tested in a trial, and none of it is a suggestion.',
};
// A boundary sentence from the intent map opens the lede when one exists (policy evidence-with-boundary).
const ledeFor = (f: string) => [boundaryFor(intent, f), defaultLedes[f]].filter(Boolean).join(' ');

// Body blocks. Each renders only when it has content; an evidence field with no
// claims but with mapped demand renders as an explicit absence statement.
type Guide = { id: string; heading: string; lede?: string; html: string; pending?: boolean };
const guide: Guide[] = ((d as any).guide ?? []) as Guide[];
type Block = { id: string; kind: 'human' | 'table' | 'landscape' | 'claims' | 'absence' | 'method' | 'compare' | 'combination' | 'regulatory' | 'open' | 'faq' | 'guide'; field?: string; label: string; group: string; guide?: Guide };
const blocks: Block[] = [];
// Written sections from the record's guide[]; the outline places them among the evidence blocks.
for (const g of guide) blocks.push({ id: g.id, kind: 'guide', label: g.heading, group: 'Evidence', guide: g });
if (showHumanTrials) blocks.push({ id: 'human-trials', kind: 'human', label: 'What happened in the human studies?', group: 'Evidence' });
if (hasAnyEvidence) blocks.push({ id: 'evidence', kind: 'table', field: 'evidence_table', label: headingFor(intent, 'evidence_table', 'What the evidence shows'), group: 'Evidence' });
else blocks.push({ id: 'landscape', kind: 'landscape', label: 'What is indexed', group: 'Evidence' });
for (const [f, id, label] of evidence) {
  if (has(f)) blocks.push({ id, kind: 'claims', field: f, label: headingFor(intent, f, label), group: 'Evidence' });
  else if (queriesFor(intent, f).some((q) => q.policy !== 'redirect')) blocks.push({ id, kind: 'absence', field: f, label: headingFor(intent, f, label), group: 'Evidence' });
}
if (hasAnyEvidence) blocks.push({ id: 'method', kind: 'method', label: 'Method notes', group: 'Method' });
if (peerEntries.length > 0) blocks.push({ id: 'compare', kind: 'compare', label: headingFor(intent, 'compare', 'How it compares'), group: 'Context' });
if (inStacks.length > 0) blocks.push({ id: 'combination', kind: 'combination', label: headingFor(intent, 'combination', 'Studied in combination'), group: 'Context' });
if (has('regulatory_status')) blocks.push({ id: 'regulatory', kind: 'regulatory', field: 'regulatory_status', label: headingFor(intent, 'regulatory_status', 'Regulatory status'), group: 'Context' });
if (d.open_questions.length > 0) blocks.push({ id: 'open', kind: 'open', label: 'Open questions and limitations', group: 'Context' });

// FAQ: intent-mapped questions first (in the searcher's words, answered from a
// claim or from our own prose), then the record's derived questions.
const intentFaq = queriesFor(intent, 'faq').map((q) => {
  const claim = q.answer_from ? (A[q.answer_from] ?? [])[0] : undefined;
  if (claim) {
    const p = parseClaim(claim);
    const src = claim.source_ids?.[0];
    const body = p.quote ? `${esc(p.design)}${p.year ? `, ${p.year}` : ''}: <q>${esc(p.quote)}</q>` : esc(claim.value);
    return { question: q.heading ?? q.query, answer: `${body}${src ? ` Source <a href="#${src}"><code>${src}</code></a>.` : ''}` };
  }
  return q.answer ? { question: q.heading ?? q.query, answer: rich(q.answer, { bold: 2, seen }) } : null;
}).filter((x): x is { question: string; answer: string } => Boolean(x));
// Redirect queries are the next questions readers ask; they become contextual links (design.md §10.3).
const nextQuestions = (intent?.queries ?? [])
  .filter((q) => q.policy === 'redirect' && q.target)
  .sort((x, y) => ((y.volume?.clickstream ?? y.volume?.google_ads ?? 0) - (x.volume?.clickstream ?? x.volume?.google_ads ?? 0)))
  .map((q) => ({ label: q.heading && !/^(How it compares|Studied in combination)$/.test(q.heading) ? q.heading : q.query.replace(/\b\w/, (c) => c.toUpperCase()), href: q.target! }))
  .filter((q, i, arr) => arr.findIndex((x) => x.href === q.href) === i);
const faqItems = [...intentFaq, ...d.faq.map((f) => ({ question: f.question, answer: rich(f.answer, { bold: 2, seen }) }))];
if (faqItems.length > 0) blocks.push({ id: 'faq', kind: 'faq', label: 'Questions people ask', group: 'Context' });

const body = orderBlocks(intent, blocks);
const secs = [
  { id: 'glance', label: 'At a glance', group: '' },
  { id: 'what', label: headingFor(intent, 'what', 'What it is'), group: '' },
  { id: 'assessment', label: 'What the evidence level means', group: 'Evidence' },
  ...body.filter((b) => b.kind !== 'method').map((b) => ({ id: b.id, label: b.label, group: b.group })),
  ...(hasAnyEvidence ? [
    { id: 'method-recon', label: 'Reconstitution mathematics', group: 'Method' },
    { id: 'method-equipment', label: 'Equipment described in studies', group: 'Method' },
    { id: 'method-coa', label: 'Reading a certificate of analysis', group: 'Method' },
  ] : []),
  { id: 'sources', label: `Sources (${d.sources.length})`, group: 'Reference' },
  { id: 'card', label: 'Reference card', group: 'Reference' },
  ...(inStacks.length + inComparisons.length + peerEntries.length > 0 ? [{ id: 'related', label: 'Related records', group: 'Reference' }] : []),
  ...(d.changelog.length > 0 ? [{ id: 'changelog', label: 'What changed', group: 'Reference' }] : []),
];
// Keep TOC order faithful to render order: method entries sit where the band renders.
const tocBody = body.flatMap((b) => b.kind === 'method'
  ? [{ id: 'method-recon', label: 'Reconstitution mathematics', group: 'Method' }, { id: 'method-equipment', label: 'Equipment described in studies', group: 'Method' }, { id: 'method-coa', label: 'Reading a certificate of analysis', group: 'Method' }]
  : [{ id: b.id, label: b.label, group: b.group }]);
const toc = [secs[0], secs[1], secs[2], ...tocBody, ...secs.filter((s) => ['sources', 'card', 'related', 'changelog'].includes(s.id))];
---
<Base title={baseTitle} description={description(entry)} path={path} indexable={isIndexable(entry)} jsonld={jsonld} siteSuffix={`${baseTitle} | Peptide Research Reference`.length <= 60}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Source+Sans+3:wght@400;600&display=swap" />
  </Fragment>
  <article class="v2">
    <div class="title">
      <div class="crumbs"><a class="eyebrow" href="/compounds">Compounds</a>{reg && <><span class="dot">·</span><a class="eyebrow" href={`/compounds#${reg.class}`}>{className(reg.class)}</a><span class="dot">·</span><span class="eyebrow">{reg.target}</span></>}</div>
      <h1>{intent?.h1 ?? d.preferred_name}</h1>
      <p class="dek" set:html={dek} />
      <div class="pills">
        <span class="pill"><Tier tier={d.evidence_tier} /></span>
        {d.review?.reviewer && <span class="pill">Reviewed {d.review.reviewed_at}</span>}
        <span class="pill">{d.sources.length} sources</span>
        {updated && <span class="pill">Updated <Fragment set:html={timeTag(updated)} /></span>}
        {brandAliases.length > 0 && <span class="pill dashed">Also: {brandAliases.join(', ')}</span>}
      </div>
    </div>

    <div class="layout">
      <aside><Toc items={toc} /></aside>
      <div class="content">
        <section id="glance"><h2>At a glance</h2><FactTiles record={d} reg={reg} /></section>
        <StatusBar review={d.review} status={d.status} sources={d.sources.length} updated={updated} />
        {intent?.decline_notice && <p class="lede">{intent.decline_notice}</p>}
        <section id="what"><h2>{headingFor(intent, 'what', 'What it is')}</h2>{summaryParas.map((html) => <p class="prose-lg" set:html={html} />)}</section>
        <EvidenceAssessment record={d} />
        {nextQuestions.length > 0 && (
          <nav class="next-q" aria-label="Related questions"><span class="eyebrow">People also look for</span>
            <ul>{nextQuestions.map((q) => <li><a href={q.href}>{q.label}</a></li>)}</ul>
          </nav>
        )}
        {noEvidence && <div class="status"><div><strong>No indexed study names this compound</strong> in its title or abstract. Everything that circulates about it is community-reported, and this page does not restate it as fact. The sections that depend on published evidence are omitted rather than filled.</div></div>}

        {body.map((b) => {
          switch (b.kind) {
            case 'guide': return <EditorialSection id={b.guide!.id} heading={b.guide!.heading} lede={b.guide!.lede} html={b.guide!.html} pending={b.guide!.pending} />;
            case 'human': return <HumanTrials rows={A.evidence_table} name={d.preferred_name} sources={d.sources} />;
            case 'landscape': return <section id="landscape"><div><h2>{b.label}</h2><p class="lede">Counts from Europe PMC. Zeros are measured, not missing.</p></div><LandscapeTable record={d} /></section>;
            case 'table': return (
              <section id="evidence">
                <div><h2>{b.label}</h2><p class="lede">{[boundaryFor(intent, 'evidence_table'), 'One row per primary study in this record\'s ledger. Fields are read from each paper\'s indexing and abstract. "Analytical method" marks papers about detecting or measuring the compound rather than about its effects.'].filter(Boolean).join(' ')}</p></div>
                <EvidenceTable rows={A.evidence_table} />
              </section>
            );
            case 'claims': return (
              <section id={b.id}><div><h2>{b.label}</h2><p class="lede">{ledeFor(b.field!)}</p></div><ClaimCards claims={A[b.field!]} sources={d.sources} />{b.field === 'weight_normalized_doses' && <WeightCaveat />}</section>
            );
            case 'absence': {
              const human = evidence.find(([f]) => f === b.field)?.[3] ?? b.field;
              return (
                <section id={b.id}><div><h2>{b.label}</h2></div>
                  <div class="status"><div><strong>No study in this record's ledger reports {human} for {d.preferred_name.toLowerCase()}.</strong> {d.sources.length} indexed sources were searched. {boundaryFor(intent, b.field!) ?? 'An absence in the literature is not evidence of safety or effect; it means the question has not been studied in a paper this record can cite.'}</div></div>
                </section>
              );
            }
            case 'method': return (
              <div class="method">
                <div class="grid">
                  <div><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-recon">Reconstitution mathematics</h3><ReconstitutionMath /></div>
                  <div><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-coa">Reading a certificate of analysis</h3><ReadingACoA /></div>
                  <div style="grid-column: 1 / -1"><span class="eyebrow">Method note · shared across compounds</span><h3 id="method-equipment">Equipment described in studies</h3><EquipmentInStudies /></div>
                </div>
              </div>
            );
            case 'compare': return (
              <section id="compare"><div><h2>{b.label}</h2><p class="lede">{boundaryFor(intent, 'compare') ? boundaryFor(intent, 'compare') + ' ' : ''}Same class in the registry: <Fragment set:html={peerLinks} />. Each row shows what that compound's own record states; nothing is inferred across rows.{inComparisons.length > 0 && <> Head-to-head evidence, where any exists, is on the comparison page{inComparisons.length > 1 ? 's' : ''}: <Fragment set:html={comparisonLinks} />.</>}</p></div><CompareTable self={entry} peers={peerEntries} cls={reg ? className(reg.class) : 'same'} /></section>
            );
            case 'combination': return <CombinationEvidence slug={d.slug} name={d.preferred_name} heading={b.label} boundary={boundaryFor(intent, 'combination')} />;
            case 'regulatory': return <section id="regulatory"><div><h2>{b.label}</h2><p class="lede">{[boundaryFor(intent, 'regulatory_status'), 'Registry facts only. Jurisdiction-level status, compounding categories and sport prohibitions need their own cited documents before they appear here.'].filter(Boolean).join(' ')}</p></div><ClaimCards claims={A.regulatory_status} sources={d.sources} /></section>;
            case 'open': return <section id="open"><div><h2>{b.label}</h2><p class="lede">What is genuinely unknown, stated plainly. A missing field is not evidence that the outcome is safe, effective, or established.</p></div><ul class="list">{d.open_questions.map((q) => <li>{q}</li>)}</ul>{d.evidence_assessment?.limitations?.length > 0 && <><h3>Study limitations</h3><ul class="list">{d.evidence_assessment.limitations.map((q: string) => <li>{q}</li>)}</ul></>}</section>;
            case 'faq': return <section id="faq"><h2>{b.label}</h2><Faq items={faqItems} html /></section>;
          }
        })}

        {d.sources.length > 0 && <section id="sources"><div><h2>Sources</h2><p class="lede">Full citations. Every claim above links to one of these by its id.</p></div><Sources sources={d.sources} /></section>}
        <section id="card"><h2>Reference card</h2><RefCard record={d} reg={reg} path={path} /></section>
        {(inStacks.length > 0 || inComparisons.length > 0 || peerEntries.length > 0) && (
          <section id="related"><h2>Related records</h2><ul class="cards">
            {peerEntries.map((p) => <li><a href={`/compounds/${p.data.slug}`}>{p.data.preferred_name}</a><div class="sub">Peer compound</div></li>)}
            {inStacks.map((s) => <li><a href={`/stacks/${s.slug}`}>{s.name}</a><div class="sub">Stack · wave {s.pilot_wave}</div></li>)}
            {inComparisons.map((c) => <li><a href={`/compare/${c.slug}`}>{c.sides.join(' vs ')}</a><div class="sub">Comparison · wave {c.pilot_wave}</div></li>)}
          </ul>
          <p class="lede">Browse <a href="/compounds">all compounds</a>, <a href="/stacks">stacks</a>, <a href="/compare">comparisons</a> and <a href="/tools">tools</a>.</p></section>
        )}
        {d.changelog.length > 0 && <section id="changelog"><div><h2>Last reviewed and what changed</h2><p class="lede">Newest first. These are the record's own revision dates, and the same dates feed the sitemap.</p></div><ol class="changelog" reversed>{[...d.changelog].reverse().map((c) => <li><Fragment set:html={timeTag(c.date, c.date)} /> · {c.change}</li>)}</ol></section>}
      </div>
    </div>
  </article>
</Base>

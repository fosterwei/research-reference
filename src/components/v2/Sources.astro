---
// Sections 9.4, 9.6, 9.9: numbered so a reader can cite "source 12"; external links
// open in a new tab; beyond twelve, the rest collapse. Anchors inside a closed
// <details> still resolve: browsers open the element on fragment navigation.
import { timeTag } from '../../lib/format';
interface Source { id: string; title: string; url: string; published: string; kind?: string }
interface Props { sources: Source[]; visible?: number }
const { sources, visible = 12 } = Astro.props;
const head = sources.slice(0, visible), tail = sources.slice(visible);
---
<ol class="srcs">
  {head.map((s, i) => (
    <li class="src-row" id={s.id}>
      <div class="n">{i + 1}</div>
      <div><a href={s.url} target="_blank" rel="noopener">{s.title}</a><div class="m"><code>{s.id}</code> · <Fragment set:html={timeTag(s.published)} />{s.kind ? ` · ${s.kind}` : ''}</div></div>
    </li>
  ))}
</ol>
{tail.length > 0 && (
  <details class="more-src">
    <summary>Show the remaining <b>{tail.length}</b> sources</summary>
    <ol class="srcs" start={visible + 1}>
      {tail.map((s, i) => (
        <li class="src-row" id={s.id}>
          <div class="n">{visible + i + 1}</div>
          <div><a href={s.url} target="_blank" rel="noopener">{s.title}</a><div class="m"><code>{s.id}</code> · <Fragment set:html={timeTag(s.published)} />{s.kind ? ` · ${s.kind}` : ''}</div></div>
        </li>
      ))}
    </ol>
  </details>
)}

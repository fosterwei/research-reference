---
interface Source { id: string; title: string; url: string; published: string; kind?: string }
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
<ol class="srcs">
  {sources.map((s, i) => (
    <li class="src-row" id={s.id}>
      <div class="n">{i + 1}</div>
      <div><a href={s.url} rel="noopener">{s.title}</a><div class="m">{s.id} · {s.published}{s.kind ? ` · ${s.kind}` : ''}</div></div>
    </li>
  ))}
</ol>

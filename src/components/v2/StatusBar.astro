---
// Editorial status, stated plainly. When a named person has reviewed the record
// it says who and when; otherwise it says how the page was compiled.
import { timeTag } from '../../lib/format';
interface Props { review: { author?: string; reviewer?: string; reviewer_credential?: string; reviewed_at?: string }; status: string; sources?: number; updated?: string }
const { review, sources = 0, updated } = Astro.props;
const reviewed = Boolean(review.reviewer && review.reviewer_credential && review.reviewed_at);
---
<div class={`status ${reviewed ? 'ok' : 'neutral'}`}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v.01M12 11v5"></path></svg>
  {reviewed ? (
    <div><strong>Reviewed by {review.reviewer}</strong>, {review.reviewer_credential}, on <Fragment set:html={timeTag(review.reviewed_at!)} />.{review.author && <> Written by {review.author}.</>} <a href="#changelog">What changed</a></div>
  ) : (
    <div>Compiled from <strong>{sources}</strong> indexed sources{updated && <>, updated <Fragment set:html={timeTag(updated)} /></>}. Cited findings carry an evidence tier; passages written from general knowledge are marked <em>editorial synthesis</em>. Nothing here is medical or dosing advice. <a href="#changelog">What changed</a></div>
  )}
</div>

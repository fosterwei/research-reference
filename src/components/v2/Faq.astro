---
/** `visible`: questions shown at once; the rest open on demand. Default is all. */
/** `openFirst`: the first question starts open (default); false shows every question as a closed line. */
interface Props { items: Array<{ question: string; answer: string }>; html?: boolean; visible?: number; openFirst?: boolean }
const { items, html = false, visible = Infinity, openFirst = true } = Astro.props;
const head = items.slice(0, visible), tail = items.slice(visible);
---
<div class="faq">
  {head.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary><span>{f.question}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
      {html ? <p class="a" set:html={f.answer} /> : <p class="a">{f.answer}</p>}
    </details>
  ))}
</div>
{tail.length > 0 && (
  <details class="more-rows">
    <summary>More questions (<b>{tail.length}</b>)</summary>
    <div class="faq">
      {tail.map((f) => (
        <details>
          <summary><span>{f.question}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
          {html ? <p class="a" set:html={f.answer} /> : <p class="a">{f.answer}</p>}
        </details>
      ))}
    </div>
  </details>
)}

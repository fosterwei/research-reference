---
import Tier from './Tier.astro';
import { parseClaim, type Claim } from '../../lib/claims';
import { markTerms } from '../../lib/format';
interface Props { claims: Claim[]; sources?: Array<{ id: string; url: string }> }
const { claims, sources = [] } = Astro.props;
const urlOf: Record<string, string> = Object.fromEntries(sources.map((s) => [s.id, s.url]));
const rows = claims.map((c) => {
  const p = parseClaim(c);
  // Section 9.3: the only permitted in-quote emphasis is the compound's own dose or route
  // strings the drafter extracted; the source line then says "emphasis added".
  const extraLabel = p.extra && p.extra.includes(':') ? p.extra.slice(0, p.extra.indexOf(':')) : '';
  const extraVal = p.extra ? p.extra.slice(p.extra.indexOf(':') + 1).trim() : '';
  const terms = extraVal ? extraVal.split(/;\s*/) : [];
  const [quoteHtml, marked] = p.quote ? markTerms(p.quote, terms) : ['', false];
  return { c, p, quoteHtml, marked, extraLabel, extraVal, cite: urlOf[c.source_ids[0]] };
});
---
<ul class="claims">
  {rows.map(({ c, p, quoteHtml, marked, extraLabel, extraVal, cite }) => (
    <li class={`claim ${c.evidence_label === 'editorial' ? 'editorial' : ''}`}>
      {p.quote ? (
        <>
          <div class="meta">
            {p.design && <span class="k">{p.design}</span>}
            {p.species && <span>{p.species}</span>}
            {p.n && <span>n = <span class="k">{p.n}</span></span>}
            {p.year && <span>{p.year}</span>}
            <Tier tier={c.evidence_label} />
          </div>
          {p.extra && <div class="extra">{extraLabel && <>{extraLabel.charAt(0).toUpperCase() + extraLabel.slice(1)}: </>}<span class="k">{extraVal}</span></div>}
          <q cite={cite} set:html={quoteHtml} />
        </>
      ) : (
        <div class="meta" style="align-items:flex-start"><span class="plain">{p.text}</span><Tier tier={c.evidence_label} /></div>
      )}
      <div class="src">
        {c.source_ids.length > 0 ? <>Source {c.source_ids.map((id, i) => <><a href={`#${id}`}><code>{id}</code></a>{i < c.source_ids.length - 1 ? ', ' : ''}</>)}</> : (c.evidence_label === 'editorial' ? <>Editorial synthesis from general knowledge{(c as any).pending_source ? ' · primary document to be added to the ledger' : ''}</> : 'Registry entry')}
        {p.quote && <> · quoted verbatim from the abstract{marked ? ', emphasis added' : ''}</>}
      </div>
    </li>
  ))}
</ul>

---
import Tier from './Tier.astro';
import { parseClaim, type Claim } from '../../lib/claims';
interface Props { claims: Claim[] }
const { claims } = Astro.props;
const rows = claims.map((c) => ({ c, p: parseClaim(c) }));
---
<ul class="claims">
  {rows.map(({ c, p }) => (
    <li class="claim">
      {p.quote ? (
        <>
          <div class="meta">
            {p.design && <b>{p.design}</b>}
            {p.species && <span>{p.species}</span>}
            {p.n && <span>n = <b>{p.n}</b></span>}
            {p.year && <span>{p.year}</span>}
            <Tier tier={c.evidence_label} />
          </div>
          {p.extra && (() => { const i = p.extra.indexOf(':'); const k = i > 0 ? p.extra.slice(0, i) : ''; const v = i > 0 ? p.extra.slice(i + 1).trim() : p.extra;
            return <div class="extra">{k && <>{k.charAt(0).toUpperCase() + k.slice(1)}: </>}<b>{v}</b></div>; })()}
          <q>{p.quote}</q>
        </>
      ) : (
        <div class="meta" style="align-items:flex-start"><span class="plain">{p.text}</span><Tier tier={c.evidence_label} /></div>
      )}
      <div class="src">
        {c.source_ids.length > 0 ? <>Source {c.source_ids.map((id, i) => <><a href={`#${id}`}>{id}</a>{i < c.source_ids.length - 1 ? ', ' : ''}</>)}</> : 'Registry entry'}
        {p.quote && <> · quoted verbatim from the abstract</>}
      </div>
    </li>
  ))}
</ul>

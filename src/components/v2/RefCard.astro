---
// Section 9.5: key/value data is a definition list.
import Tier from './Tier.astro';
import { formatCount } from '../../lib/site';
import { timeTag } from '../../lib/format';
interface Props { record: any; reg: any; path: string }
const { record: d, reg, path } = Astro.props;
const pubs = d.evidence_summary?.publications ?? {};
const rows = d.attributes?.evidence_table ?? [];
const routes = [...new Set(rows.map((r: any) => r.fields?.route).filter((s: string) => s && !s.startsWith('not stated')).flatMap((s: string) => s.split(', ')))].sort();
const chembl = d.evidence_summary?.chembl; const phase = chembl ? Number(chembl.max_phase) : NaN;
const generated = d.evidence_summary?.drafting?.date ?? d.evidence_summary?.retrieved_at ?? '';
---
<div class="card refcard" id="reference-card">
  <div class="head"><span class="eyebrow">Reference card · generated <Fragment set:html={generated ? timeTag(generated) : ''} /></span><span class="eyebrow">{path}</span></div>
  <dl class="refdl">
    <dt>Compound</dt><dd>{d.preferred_name}{reg ? `, ${reg.class.replace(/-/g, ' ')}` : ''}</dd>
    <dt>Evidence tier</dt><dd><Tier tier={d.evidence_tier} /></dd>
    <dt>Indexed publications</dt><dd><b>{formatCount(pubs.total)}</b> · {formatCount(pubs.randomized_controlled_trials)} RCTs · {formatCount(pubs.clinical_trials)} other clinical trials</dd>
    <dt>Approval</dt><dd>{chembl ? (phase >= 4 ? `approved (${chembl.first_approval ?? 'year not recorded'})` : `not approved · max phase ${isNaN(phase) ? '—' : phase}`) : 'no registered development programme found'}{chembl?.atc?.length ? ` · ATC ${chembl.atc.join(', ')}` : ''}</dd>
    <dt>Routes reported</dt><dd>{routes.length ? routes.join(', ') : '—'}</dd>
    {d.review?.reviewer && <><dt>Reviewed</dt><dd>{d.review.reviewer}, {d.review.reviewer_credential}, <Fragment set:html={timeTag(d.review.reviewed_at)} /></dd></>}
  </dl>
  <p class="foot">Study figures are as published in each source and are not recommendations. Print or save this card with its date.</p>
</div>

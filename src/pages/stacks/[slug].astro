---
import { records } from '../../lib/collections';
import StackV2 from '../../layouts/StackV2.astro';
export async function getStaticPaths() {
  const entries = await records('stacks');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { slug: entry.data.slug } }));
}
const { slug } = Astro.props;
---
<StackV2 slug={slug} />

---
import { records } from '../../lib/collections';
import ComparisonV2 from '../../layouts/ComparisonV2.astro';
export async function getStaticPaths() {
  const entries = await records('comparisons');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { slug: entry.data.slug } }));
}
const { slug } = Astro.props;
---
<ComparisonV2 slug={slug} />

---
import { records } from '../../lib/collections';
import GuideV2 from '../../layouts/GuideV2.astro';
export async function getStaticPaths() {
  const entries = await records('posts');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<GuideV2 entry={entry} />

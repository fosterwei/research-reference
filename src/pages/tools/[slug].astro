---
// Tool pages come from the registry plan, so a calculator exists before a
// reviewed record does. Nothing here accepts a body weight or a condition, and
// nothing returns a dose: each tool states its formula above its inputs so the
// arithmetic can be checked by hand, and each names the one thing it refuses.
import Base from '../../layouts/Base.astro';
import Calculators from '../../components/Calculators.astro';
import { tools } from '../../lib/registry';
import { records } from '../../lib/collections';
import { isIndexable } from '../../lib/site';

export async function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug }, props: { tool: t } }));
}
const { tool } = Astro.props;
const toolRecords = await records('tools');
const record = toolRecords.find((r) => r.data.slug === tool.slug);
const indexable = record ? isIndexable(record) : false;
const path = `/tools/${tool.slug}`;
const peers = tools.filter((t) => t.slug !== tool.slug);

const COPY: Record<string, { h1: string; dek: string; title: string; description: string }> = {
  'reconstitution-calculator': {
    h1: 'Peptide reconstitution calculator',
    dek: 'Enter what is in the vial and what you want to draw. It returns the concentration, the volume, and that volume in units on the syringe scale you pick, with the formula printed above the inputs.',
    title: 'Peptide Reconstitution Calculator: mg to mL and Units',
    description: 'Work out concentration, volume to draw and syringe units from vial mass and diluent. Formula shown, U-100, U-50 and U-40 scales, nothing stored.',
  },
  'unit-converter': {
    h1: 'Peptide unit converter',
    dek: 'Milligrams, micrograms and nanograms are fixed ratios. Millilitres to syringe units depends on the scale printed on the barrel. International units are neither, and this page explains why it will not convert them.',
    title: 'Peptide Unit Converter: mg, mcg, ng and Syringe Units',
    description: 'Convert mg, mcg and ng, and millilitres to units on U-100, U-50 or U-40 syringes. Explains why no honest converter offers a general IU conversion.',
  },
  'vial-planner': {
    h1: 'Vial planner',
    dek: 'How many whole draws a vial yields at a stated mass per draw, how long that lasts at a stated frequency, and how much is left that cannot be drawn.',
    title: 'Peptide Vial Planner: Draws per Vial and How Long It Lasts',
    description: 'How many whole draws a vial gives at a stated mass per draw, the volume of each, how long it lasts, and the remainder too small to measure.',
  },
};
const copy = COPY[tool.slug] ?? {
  h1: tool.name, dek: tool.computes,
  title: tool.name, description: `${tool.name}: ${tool.computes}.`,
};
---
<Base title={copy.title} description={copy.description} path={path} indexable={indexable} siteSuffix={false}>
  <article class="prose-page">
    <p class="eyebrow"><a href="/tools">Tools</a></p>
    <h1>{copy.h1}</h1>
    <p class="dek">{copy.dek}</p>

    <dl class="facts">
      <dt>Computes</dt><dd>{tool.computes}</dd>
      <dt>Refuses</dt><dd>{tool.refuses}</dd>
      <dt>Sends anywhere</dt><dd>Nothing. The arithmetic runs in your browser and no value is transmitted or stored.</dd>
    </dl>

    <Calculators slug={tool.slug} />

    <h2>What this tool will not do</h2>
    <p class="prose">It refuses {tool.refuses}. That is not a missing feature. A calculator that turns a body weight into a milligram figure has produced a dose, and a dose is a clinical decision that depends on why someone is taking something, what else they take and what their kidneys and liver are doing. None of that is arithmetic, and none of it is knowable from a number typed into a box.</p>
    <p class="prose">Every figure this returns is a conversion of numbers you supplied. It carries no opinion about whether those numbers are appropriate, and the site's <a href="/about">evidence pages</a> are where the question of what has actually been studied belongs.</p>

    <h2>Checking it by hand</h2>
    <p class="prose">The formula is printed above the inputs so you can verify any result with a calculator you already trust. If a number here disagrees with one you worked out yourself, the discrepancy is worth reporting through the <a href="/contact">corrections page</a>; arithmetic is the one thing on this site that can be checked without reading a paper.</p>

    {!record && <div class="notice"><p>This tool has no reviewed record yet, so it is excluded from search indexing. The arithmetic works and can be checked against the formula above.</p></div>}

    <h2>Other tools</h2>
    <ul class="cards">{peers.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a><div class="sub">{t.computes}</div></li>)}</ul>
  </article>
</Base>

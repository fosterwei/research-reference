---
// Homepage. It opens with the site's atomic unit: one sentence quoted from a
// paper, with the kind of evidence it is and the paper it came from. The
// sentence is chosen at build time from the ledgers by a fixed rule, so it is
// a quotation rather than copy, and it changes only when the records do.
//
// Every number on the page is computed from the records, and every list is
// sorted explicitly, because collection order comes from the filesystem and
// the lastmod guard fingerprints the rendered text.
//
// What is deliberately not here: supplier deals, discount codes, affiliate
// links, a newsletter, a shop. Commercial intent is out of scope.
import fs from 'node:fs';
import path from 'node:path';
import '../styles/compound-v2.css';
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import Tier from '../components/v2/Tier.astro';
import Faq from '../components/v2/Faq.astro';
import ReconstitutionMath from '../components/shared/ReconstitutionMath.astro';
import { records } from '../lib/collections';
import { isIndexable, lastmod, formatCount, SITE_NAME, imageObjects } from '../lib/site';
import { qualifies } from '../lib/calculators';
import { loadIntent } from '../lib/intents';
import { compound as regCompound, className, stacks as regStacks, tools as regTools } from '../lib/registry';
import { timeTag } from '../lib/format';

const compounds = await records('compounds');
const stacks = await records('stacks');
const comparisons = await records('comparisons');

const en = (a: string, b: string) => a.localeCompare(b, 'en');
const written = compounds.filter(isIndexable);
const writtenStacks = stacks.filter(isIndexable).sort((a, b) => en(a.data.slug, b.data.slug));
const writtenComparisons = comparisons.filter(isIndexable);
const withCalculator = compounds.filter(qualifies);

const sources = compounds.reduce((n, e) => n + e.data.sources.length, 0);
const reviewer = (written.find((e) => (e.data as any).review?.reviewer)?.data as any)?.review;

// Newest change to any page other than this one. Never the build date, and
// never this page's own entry: the badge is printed here, so including it
// would make stamping the page change the page.
const manifest = (() => {
  try { return JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'research', 'lastmod.json'), 'utf8')); } catch { return { pages: {} }; }
})();
const updated = [
  ...[...compounds, ...stacks, ...comparisons].map(lastmod).filter(Boolean) as string[],
  ...Object.entries(manifest.pages ?? {}).filter(([k]) => k !== '/').map(([, p]: any) => p.lastmod).filter(Boolean) as string[],
].sort().at(-1);

/* The hero statement (plain English since 2026-11-08; the abstract sentence stays in the record).
   Candidates are every claim on a written record whose value contains its
   verbatim source excerpt and whose evidence is human: an approved label or a
   clinical trial first, observational second. Among those, the largest study
   wins, then the slug, then the text, so the choice is deterministic and
   changes only when the ledgers do. Length is bounded so it reads as one
   sentence rather than a paragraph. */
const TIER_RANK: Record<string, number> = { 'approved-label': 0, 'human-clinical-trial': 0, 'observational-human': 1 };
const TIER_VAR: Record<string, string> = {
  'approved-label': '--t-approved', 'human-clinical-trial': '--t-trial', 'observational-human': '--t-obs',
  'animal-preclinical': '--t-animal', 'mechanistic-in-vitro': '--t-vitro', 'community-reported': '--t-community',
};
type Candidate = { e: any; tier: string; lead: string; text: string; n: number; sid?: string; url?: string };
const candidates: Candidate[] = [];
for (const e of written) {
  const d = e.data as any;
  const srcs = new Map<string, any>((d.sources ?? []).map((s: any) => [s.id, s]));
  for (const [field, claims] of Object.entries(d.attributes ?? {})) {
    for (const c of claims as any[]) {
      const tier = String(c.evidence_label ?? '');
      if (!(tier in TIER_RANK)) continue;
      if (field === 'evidence_table' && /method|in vitro|measured, not given/i.test(c.fields?.design ?? '')) continue;
      const excerpt = String(c.source_excerpt ?? '').trim();
      const value = String(c.value ?? '');
      const at = excerpt ? value.indexOf(excerpt) : -1;
      if (at <= 0 || !c.plain || /^Background\b/.test(c.plain)) continue;
      // The page shows the plain-English statement, never the abstract's own words.
      const text = String(c.plain).trim();
      const words = text.split(/\s+/).length;
      if (words < 12 || words > 42 || !/[.!?]$/.test(text)) continue;
      const lead = value.slice(0, at).replace(/[:\s]+$/, '');
      const n = Number((lead.match(/\bn\s*=\s*([\d,]+)/) ?? [])[1]?.replace(/,/g, '')) || 0;
      const sid = (c.source_ids ?? [])[0];
      const label = c.fields?.study || (sid ? srcs.get(sid)?.title?.split(/[.:]/)[0] : undefined);
      candidates.push({ e, tier, lead, text, n, sid: label ?? sid, url: sid ? srcs.get(sid)?.url : undefined });
    }
  }
}
candidates.sort((a, b) => TIER_RANK[a.tier] - TIER_RANK[b.tier] || b.n - a.n || en(a.e.data.slug, b.e.data.slug) || en(a.text, b.text));
const hero = candidates[0];

// Ranked by measured monthly searches from each record's intent map, not by us.
const demand = (slug: string) => {
  const m = loadIntent(slug);
  return Math.max(0, ...(m?.queries ?? []).map((q) => q.volume?.clickstream ?? q.volume?.google_ads ?? 0));
};
const mostSearched = written
  .map((e) => ({ e, v: demand(e.data.slug) }))
  .filter((x) => x.v > 0)
  .sort((a, b) => b.v - a.v || en(a.e.data.slug, b.e.data.slug))
  .slice(0, 10);

const humanRows = (e: any) => ((e.data.attributes?.evidence_table ?? []) as any[])
  .filter((r) => r.fields?.species === 'Humans' && !/method|in vitro|measured, not given/i.test(r.fields?.design ?? '')).length;
const reference = [...written].sort((a, b) => en(a.data.preferred_name, b.data.preferred_name));

const faq = [
  { question: 'What is this site?', answer: `A research reference for peptides. Every page is built from a record of indexed studies, restated statement by statement in plain English, each cited to its paper and labelled by the kind of evidence it is: approved label, clinical trial, observational, animal, laboratory. Where nothing has been studied, the page says so. It is written for readers, reviewed by a named pharmacist, and sells nothing.` },
  { question: 'Does it give dosing information?', answer: `Yes, with its provenance. The doses on a page are the doses published studies administered and labels state, reported as the source states them, with the species and the study design beside each one; where a record has human regimens, a practical protocol section reads them into a schedule and names the rows it is built from. The protocol section on a compound page shows approved-label dosing, the regimens trials used, and a practical schedule read from them, each with its source. The calculators convert a mass and a volume into syringe units and refuse a body-weight input, because that would turn arithmetic into individual advice.` },
  { question: 'Where do the numbers come from?', answer: `Europe PMC, which indexes the biomedical literature, and ChEMBL for compound identity and approval status. Each statement ends with a numbered mark that links to the paper it came from, so any claim can be checked against its source in one click.` },
  { question: 'How do I work out syringe units for a dose?', answer: `Divide the mass in the vial by the diluent volume to get the concentration, then divide the mass you want by that concentration to get the volume. Units on a U-100 syringe are that volume in millilitres times 100. A 5 mg vial in 2 mL is 2,500 mcg/mL, so 250 mcg is 0.1 mL, which is 10 units. The reconstitution calculator does this and shows its working.` },
  { question: 'What does the evidence tier mean?', answer: `The strongest kind of study that exists for that compound, not a judgment of the compound. "Human clinical trial" means at least one indexed trial in people exists; it says nothing about the trial's size or whether it found an effect. The evidence table on each page shows that.` },
  { question: 'Who checks the pages?', answer: reviewer ? `${reviewer.reviewer}, ${reviewer.reviewer_credential}, is named as reviewer of record on every written page, with the date, at the top of the page and in its structured data. Corrections are made in the record and dated in the changelog; nothing is corrected silently.` : `A named, credentialed reviewer signs each written page before it is indexed.` },
];

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: Astro.site?.toString() },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE_NAME, url: Astro.site?.toString(), logo: imageObjects(Astro.site).logo },
];
---
<Base title="Peptide Research, Cited and Tiered | Dashnaiv Peptides" description="Peptide research reference: the doses studies used, side effects reported, evidence tiers on every claim, and calculators that show their working. Nothing sold." path="/" indexable={written.length > 0} jsonld={jsonld}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Source+Sans+3:wght@400;600&display=swap" />
  </Fragment>
  <article class="v2 home">
    <section class="band" aria-label="Introduction"><div class="hero">
      <div class="text">
        <h1>Peptide research, cited to its source.</h1>
        {hero && (
          <figure class="claim" style={`--tier: var(${TIER_VAR[hero.tier] ?? '--rule'})`}>
            <p class="hero-claim">{hero.text}</p>
            <figcaption class="attr">
              <Tier tier={hero.tier} />
              <a href={`/compounds/${hero.e.data.slug}`}>{hero.e.data.preferred_name}</a>
              <span>{hero.lead}</span>
              {hero.url
                ? <cite><a href={hero.url} rel="nofollow noopener">{hero.sid}</a></cite>
                : hero.sid && <cite>{hero.sid}</cite>}
            </figcaption>
          </figure>
        )}
        <p class="after">{written.length} compounds, {writtenStacks.length} stacks and {writtenComparisons.length} comparisons are read this way: every claim carries the kind of evidence it came from and a link to the paper, {sources.toLocaleString('en-US')} papers in all. Where no study exists, the page says so instead of filling the space.{reviewer && ` Each page is checked by a ${reviewer.reviewer_credential} before it is indexed`}{updated && <Fragment>, last on <Fragment set:html={timeTag(updated)} /></Fragment>}.</p>
        <ul class="cta">
          <li><a href="/compounds">Browse the {compounds.length} compounds</a></li>
          <li><a href="/calculators">Dosage calculators</a></li>
          <li><a href="/about">How the pages are made</a></li>
        </ul>
        <p class="note">General information from published studies and labels, not individual medical advice. A dose on these pages is one a study, a label or our protocol section reports, with its source beside it.</p>
      </div>
      <figure class="figure"><img src="/images/home/hero.webp" width="1200" height="1200" alt="A researcher in safety glasses holds a small vial up to a transparent display showing a molecule, a chart, and a page of text with one line highlighted." fetchpriority="high" decoding="async" /></figure>
    </div></section>

    <div class="content">
      <section id="reference" class="band tint"><div class="head"><h2>Evidence at a glance</h2><p class="lede">Every written compound, with the strongest evidence that exists for it and how much of its ledger is human. No dose ranges: a dose belongs beside the study that used it, which is where each page keeps them.</p></div>
        <div class="card clip"><div class="tblwrap"><table class="tbl">
          <caption>Counts from each record's own ledger. Publications and randomised trials are as indexed in Europe PMC for the compound or a listed alias.</caption>
          <thead><tr><th scope="col">Compound</th><th scope="col">Class</th><th scope="col">Evidence tier</th><th scope="col" class="num">Publications</th><th scope="col" class="num">RCTs</th><th scope="col" class="num">Human studies</th><th scope="col">Calculator</th></tr></thead>
          <tbody>
            {reference.map((e) => { const p = (e.data as any).evidence_summary?.publications ?? {}; const reg = regCompound(e.data.slug); return (
              <tr>
                <td class="study"><a href={`/compounds/${e.data.slug}`}>{e.data.preferred_name}</a></td>
                <td>{reg ? className(reg.class) : ''}</td>
                <td><Tier tier={e.data.evidence_tier} /></td>
                <td class="num">{formatCount(p.total)}</td>
                <td class="num">{formatCount(p.randomized_controlled_trials)}</td>
                <td class="num">{humanRows(e)}</td>
                <td>{qualifies(e) ? <a href={`/calculators/${e.data.slug}`}>Units chart</a> : ''}</td>
              </tr>
            ); })}
          </tbody>
        </table></div></div>
      </section>

      {mostSearched.length > 0 && (
        <section id="most-searched" class="band"><div class="head"><h2>Most searched compounds</h2><p class="lede">Ranked by measured monthly searches, from the demand research behind each page. What people look for, not what we chose to promote.</p></div>
          <ol class="rank">
            {mostSearched.map(({ e, v }, i) => (
              <li><span class="n">{i + 1}</span><a class="name" href={`/compounds/${e.data.slug}`}>{e.data.preferred_name}</a><Tier tier={e.data.evidence_tier} /><span class="meta">{v.toLocaleString('en-US')} a month</span></li>
            ))}
          </ol>
        </section>
      )}

      <section id="reconstitution" class="band tint"><div class="head"><h2>Reconstitution quick reference</h2><p class="lede">Two divisions, and the one error that causes most of the rest.</p></div>
        <figure class="figure"><img src="/images/home/reconstitution.webp" width="1600" height="700" alt="A researcher at a laboratory bench holds a vial of clear liquid above a row of vials, some holding white powder and some holding liquid, beside a microscope." loading="lazy" decoding="async" /></figure>
        <ReconstitutionMath />
        <ul class="links">
          <li><a href="/tools/reconstitution-calculator">Reconstitution calculator</a><span class="what">Concentration, volume and units on U-100, U-50 or U-40</span></li>
          <li><a href="/tools/unit-converter">Unit converter</a><span class="what">mg, mcg, ng and millilitres to units, and why it will not convert IU</span></li>
          <li><a href="/tools/vial-planner">Vial planner</a><span class="what">Whole draws per vial, how long it lasts, and the remainder</span></li>
        </ul>
      </section>

      <section id="stacks" class="band" aria-label="Stacks, comparisons and calculators"><div class="two">
        <div>
          <div class="head"><h2>Stacks and comparisons</h2><p class="lede">A stack page states whether any study gave the components together, which is usually the finding. A comparison page states whether a head-to-head trial exists before it compares anything.</p></div>
          <ul class="links" style="margin-top:16px">
            {writtenStacks.map((s) => { const reg = regStacks.find((r) => r.slug === s.data.slug); const n = ((s.data as any).attributes?.combination_evidence ?? []).length; return (
              <li><a href={`/stacks/${s.data.slug}`}>{reg?.name ?? (s.data as any).title}</a><span class="what">{n === 0 ? 'No indexed paper names every component' : `${n} indexed ${n === 1 ? 'paper names' : 'papers name'} every component`}</span></li>
            ); })}
            <li><a href="/compare">All {writtenComparisons.length} comparisons</a><span class="what">Head-to-head pages, each opening with whether a direct trial exists</span></li>
          </ul>
        </div>
        <div id="calculators">
          <div class="head"><h2>Calculators that show their working</h2><p class="lede">Each prints its formula above the inputs so any result can be checked by hand, runs entirely in your browser, and refuses one input: a body weight, because that would turn arithmetic into individual advice.</p></div>
          <ul class="links" style="margin-top:16px">
            {regTools.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a><span class="what">{t.computes}</span></li>)}
            <li><a href="/calculators">Per-compound calculators</a><span class="what">{withCalculator.length} compounds, each with a units chart whose rows are the doses its own studies used</span></li>
          </ul>
        </div>
      </div></section>

      <section id="method" class="band navy"><div class="head"><h2>How these pages are made</h2></div>
        <figure class="figure"><img src="/images/home/process.webp" width="1800" height="600" alt="Four round scenes joined by arrows: a researcher reading papers, a screen showing a page with one line highlighted, a vial beside a molecular model, and a reviewer at a screen with a check mark." loading="lazy" decoding="async" /></figure>
        <div class="two">
          <p class="prose-lg">For each compound, every publication in Europe PMC naming it or a listed alias is retrieved with its indexing. Each is labelled by study design and species. Sentences that state a dose, an outcome, an adverse event or a duration become plain-English claims, tiered by the evidence they came from, and linked to their paper with a numbered mark. Reviews are kept as background and never become claims. The result is checked by a named pharmacist before it is indexed, corrections are made in the record and dated, and the page is rebuilt from it.</p>
          <ul class="links">
            <li><a href="/about">The method in full</a><span class="what">Retrieval, tiers, review, and what the site deliberately does not do</span></li>
            <li><a href="/contact">Report a correction</a><span class="what">A statement that differs from its source, a wrong tier, a changed status</span></li>
            <li><a href="/privacy">Privacy</a><span class="what">What is collected, the one analytics cookie, and how to refuse it</span></li>
          </ul>
        </div>
      </section>

      <section id="contains" class="band"><div class="two">
        <div>
          <div class="head"><h2>What every compound record contains</h2><p class="lede">The same sections in the same order on every page, so a reader who has used one has used them all. A section with no evidence is not rendered; a zero is reported as a zero.</p></div>
          <ol class="list" style="margin-top:16px">
            <li><strong>In two minutes.</strong> What it is, the best-evidenced number, and what has not happened yet.</li>
            <li><strong>What it is and how it is thought to work.</strong> Marked as editorial synthesis where it draws on general knowledge.</li>
            <li><strong>What the evidence level means.</strong> The tier, and what it does and does not say.</li>
            <li><strong>What happened in the human studies.</strong> Every human row in the ledger: design, size, year, outcome as published.</li>
            <li><strong>The evidence table.</strong> Every indexed study, by species and design, with what it found.</li>
            <li><strong>Doses studies used.</strong> As the paper states them, with species and route, never converted between them.</li>
            <li><strong>Dosage chart: studies versus what circulates.</strong> The two kinds of figure, kept apart.</li>
            <li><strong>Side effects reported.</strong> At the doses the trials used.</li>
            <li><strong>What studies measured.</strong> Biomarkers, timelines, durations, routes, weight-normalised doses.</li>
            <li><strong>Reconstitution, storage and monitoring.</strong> Arithmetic and what the literature states, not instructions.</li>
            <li><strong>Common mistakes in how it is discussed.</strong> Each one visible on a page currently ranking for the compound.</li>
            <li><strong>Comparisons, combinations and regulatory status.</strong> Registry facts only.</li>
            <li><strong>Open questions, FAQ, sources, reference card.</strong> And a dated changelog of every correction.</li>
          </ol>
        </div>
        <figure class="figure"><img src="/images/home/record.webp" width="900" height="1200" alt="A researcher examines a vial while a screen beside him shows a page of text with one line highlighted, next to a microscope and a rack of test tubes." loading="lazy" decoding="async" /></figure>
      </div></section>

      <section id="faq" class="band tint"><h2>Questions people ask</h2><Faq items={faq} /></section>
    </div>
  </article>
</Base>

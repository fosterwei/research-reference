---
import { records } from '../../lib/collections';
import Base from '../../layouts/Base.astro';
import ReviewedBy from '../../components/ReviewedBy.astro';
import Snapshot from '../../components/Snapshot.astro';
import ClaimList from '../../components/ClaimList.astro';
import SourceList from '../../components/SourceList.astro';
import Compare from '../../components/Compare.astro';
import { SECTIONS, isIndexable, title, description, lastmod } from '../../lib/site';
import { compound as regCompound, peers as regPeers, stacksContaining, comparisonsWith } from '../../lib/registry';

export async function getStaticPaths() {
  const entries = await records('compounds');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const reg = regCompound(d.slug);
const all = await records('compounds');
const peerEntries = regPeers(d.slug)
  .map((p) => all.find((e) => e.data.slug === p.slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
const inStacks = stacksContaining(d.slug);
const inComparisons = comparisonsWith(d.slug);
const indexable = isIndexable(entry);
const populated = SECTIONS.filter(([field]) => (d.attributes[field] ?? []).length > 0);
const noEvidence = (d.evidence_summary?.publications?.total ?? 0) === 0;
const path = `/compounds/${d.slug}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title(entry),
  description: description(entry),
  dateModified: lastmod(entry),
  mainEntityOfPage: new URL(path, Astro.site).toString(),
  ...(d.review.reviewer ? { reviewedBy: { '@type': 'Person', name: d.review.reviewer, jobTitle: d.review.reviewer_credential } } : {}),
};
---
<Base title={title(entry)} description={description(entry)} path={path} indexable={indexable} jsonld={jsonld}>
  <article>
    <p class="eyebrow">Compound{reg ? ` · wave ${reg.pilot_wave}` : ''}</p>
    <h1>{d.preferred_name}</h1>

    <ReviewedBy review={d.review} status={d.status} />

    <h2>Snapshot</h2>
    <Snapshot tier={d.evidence_tier} summary={d.evidence_summary} reg={reg} aliases={d.aliases} />

    <h2>What it is</h2>
    <div class="prose"><p>{d.summary}</p></div>

    {noEvidence && (
      <div class="notice">
        <p>No indexed study names this compound in its title or abstract. Everything that circulates about it is community-reported, and this page does not restate it as fact. The sections below that depend on published evidence are omitted rather than filled.</p>
      </div>
    )}

    {populated.map(([field, heading]) => (
      <section>
        <h2>{heading}</h2>
        <ClaimList claims={d.attributes[field]} />
      </section>
    ))}

    {peerEntries.length > 0 && (
      <section>
        <h2>How it compares</h2>
        <p class="lede">Same class in the registry. Each row shows what that compound's own record states; nothing is inferred across rows.</p>
        <Compare self={entry} peers={peerEntries} />
      </section>
    )}

    {d.open_questions.length > 0 && (
      <section>
        <h2>Open questions</h2>
        <ul>{d.open_questions.map((q) => <li>{q}</li>)}</ul>
      </section>
    )}

    {d.faq.length > 0 && (
      <section>
        <h2>Questions people ask</h2>
        {d.faq.map((f) => <><h3>{f.question}</h3><p>{f.answer}</p></>)}
      </section>
    )}

    {d.sources.length > 0 && (
      <section>
        <h2>Sources</h2>
        <SourceList sources={d.sources} />
      </section>
    )}

    {(inStacks.length > 0 || inComparisons.length > 0 || peerEntries.length > 0) && (
      <section>
        <h2>Related records</h2>
        <ul class="cards">
          {peerEntries.map((p) => <li><a href={`/compounds/${p.data.slug}`}>{p.data.preferred_name}</a><div class="sub">Peer compound</div></li>)}
          {inStacks.map((s) => <li><a href={`/stacks/${s.slug}`}>{s.name}</a><div class="sub">Stack · wave {s.pilot_wave}</div></li>)}
          {inComparisons.map((c) => <li><a href={`/compare/${c.slug}`}>{c.sides.join(' vs ')}</a><div class="sub">Comparison · wave {c.pilot_wave}</div></li>)}
        </ul>
      </section>
    )}

    {d.changelog.length > 0 && (
      <section id="changelog">
        <h2>Last reviewed and what changed</h2>
        <ul>{[...d.changelog].reverse().map((c) => <li><code>{c.date}</code> {c.change}</li>)}</ul>
      </section>
    )}
  </article>
</Base>

---
// Every compound renders with the v2 layout (docs/design.md §4, §10). The v2
// design was trialled on semaglutide and ipamorelin and adopted 2026-09-24;
// a page composes from research/intents/<slug>.json when a map exists.
import { records } from '../../lib/collections';
import CompoundV2 from '../../layouts/CompoundV2.astro';

export async function getStaticPaths() {
  const entries = await records('compounds');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { slug: entry.data.slug } }));
}
const { slug } = Astro.props;
---
<CompoundV2 slug={slug} />
